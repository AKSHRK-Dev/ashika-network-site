---
/**
 * 全ページ共通のフッター。
 * 濃紺の面に、紹介（ロゴ・一言・取り組み・SNS）とサイト全体のリンクを並べる。
 * リンクは、分類ごとに1行（左に分類名、右にリンクを横に並べる）にして、縦に長くならないようにする。
 * スマホでは、分類の名前だけを並べて、押すと中のリンクが開く形にする（全部を広げると画面3枚ぶんになり、
 * 目当ての分類を探すほうが手間になるので）。いちばん下に著作権表示と「先頭へ」。
 */
import Icon from './Icon.astro';
import { content } from '../data/index';
import { langOf } from '../i18n';

const lang = langOf(Astro.url);
const { brand, footerColumns, footerText, site, snsItems, ui } = content(lang).site;
/* スマホで分類をたたんでも、規約・特商法の表記だけは開かずに届くようにしておく（お支払いの前に確かめる人のため） */
const legalLinks = footerColumns
  .flatMap((col) => col.items)
  .filter((it) => /\/(terms|privacy|tokusho)$/.test(it.href));
---

<footer class="footer wm wm-dark">
  <div class="container ft-main">
    <div class="ft-brand">
      <a class="ft-logo" href={lang === 'en' ? '/en' : '/'} aria-label={ui.footer.brandAria}>
        <img src={brand.footer.src} alt={site.name} width={brand.footer.width} height={brand.footer.height} loading="lazy" />
      </a>
      <p class="ft-catch">{footerText.catch}</p>
      <p class="ft-about">{footerText.about.split('\n').join(lang === 'en' ? ' ' : '')}</p>
      <a class="ft-climate" href={footerText.climate.href}>
        <span class="ft-climate-ic"><Icon name="leaf" size={18} /></span>
        <span>{footerText.climate.label}</span>
      </a>
      <ul class="ft-sns" aria-label={ui.footer.snsAria}>
        {
          snsItems.map((s) => (
            <li>
              <a href={s.href} target="_blank" rel="noopener" aria-label={s.label}>
                <Icon name={s.name} size={s.size} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <nav class="ft-cols" aria-label={ui.footer.columnsAria}>
      {
        footerColumns.map((col) => (
          <div class="ft-col">
            <h2>{col.title}</h2>
            <ul>
              {col.items.map((it) => (
                <li>
                  <a href={it.href} target={it.external ? '_blank' : undefined} rel={it.external ? 'noopener' : undefined}>
                    {it.external ? (
                      <Fragment>
                        {it.label.slice(0, -1)}
                        <span class="nw">
                          {it.label.slice(-1)}
                          <Icon name="external" size={13} />
                        </span>
                      </Fragment>
                    ) : (
                      it.label
                    )}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>

    <nav class="ft-acc" aria-label={ui.footer.columnsAria}>
      {
        footerColumns.map((col) => (
          <details>
            <summary>
              {col.title}
              <Icon name="chevron" size={16} />
            </summary>
            <ul>
              {col.items.map((it) => (
                <li>
                  <a href={it.href} target={it.external ? '_blank' : undefined} rel={it.external ? 'noopener' : undefined}>
                    {it.label}
                    {it.external && <Icon name="external" size={12} />}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        ))
      }
    </nav>

    <ul class="ft-legal">
      {
        legalLinks.map((it) => (
          <li>
            <a href={it.href}>{it.label}</a>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="ft-bottom">
    <div class="container ft-bottom-in">
      <div class="ft-meta">
        <p>{footerText.region}</p>
        <p>
          <span>{footerText.copyright}</span>
          <span class="ft-credit">{footerText.credit.before} <a href={footerText.credit.href}>{footerText.credit.name}</a></span>
        </p>
      </div>
      <a class="ft-top" href="#top">
        <Icon name="chevron" size={18} />
        {footerText.toTop}
      </a>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--night);
    color: #dfe8f6;
    border-top: 4px solid var(--hl-deep);
  }

  .ft-main {
    display: grid;
    gap: clamp(36px, 5vw, 64px);
    padding-block: clamp(44px, 6vw, 72px) clamp(36px, 5vw, 56px);
  }

  /* ロゴは青い画像なので、濃い面の上では白い形に変えて見せる */
  .ft-logo {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
  }

  .ft-logo img {
    width: auto;
    height: 48px;
    filter: brightness(0) invert(1);
  }

  .ft-catch {
    margin-top: 1.25rem;
    color: #fff;
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  .ft-about {
    margin-top: 0.6rem;
    max-width: 34em;
    font-size: 0.9375rem;
  }

  .ft-climate {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    max-width: 34em;
    margin-top: 1.25rem;
    padding: 12px 14px;
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: var(--r);
    color: #fff;
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .ft-climate:hover {
    border-color: #fff;
    background: rgba(255, 255, 255, 0.08);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .ft-climate-ic {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    margin-top: -2px;
    border-radius: 50%;
    background: #fff;
    color: var(--ok);
  }

  .ft-sns {
    display: flex;
    gap: 10px;
    margin-top: 1.25rem;
    list-style: none;
  }

  .ft-sns a {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid rgba(255, 255, 255, 0.55);
    border-radius: 50%;
    color: #fff;
  }

  .ft-sns a:hover {
    background: #fff;
    color: var(--night);
  }

  .ft-cols {
    border-bottom: 1px solid rgba(255, 255, 255, 0.22);
  }

  .ft-col {
    padding-block: 10px;
    border-top: 1px solid rgba(255, 255, 255, 0.22);
  }

  .ft-col h2 {
    padding-block: 4px;
    color: #fff;
    font-size: 0.875rem;
    letter-spacing: 0.06em;
    line-height: 1.5;
  }

  .ft-col ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 18px;
    list-style: none;
  }

  /* 折り返しても、外部リンクの印が文字のすぐ後ろに付くように、行の中の要素として置く */
  .ft-col a {
    display: inline-block;
    padding-block: 8px;
    font-size: 0.875rem;
    line-height: 1.5;
  }

  /* 外部リンクの印だけが次の行に落ちないように、最後の1文字とつなげておく */
  .nw {
    white-space: nowrap;
  }

  .ft-col a :global(svg) {
    display: inline-block;
    margin-left: 0.3em;
    vertical-align: -0.08em;
    opacity: 0.8;
  }

  .ft-acc,
  .ft-legal {
    display: none;
  }

  .ft-col a:hover,
  .ft-acc a:hover,
  .ft-legal a:hover,
  .ft-meta a:hover,
  .ft-top:hover {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .ft-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.25);
  }

  .ft-bottom-in {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    padding-block: 20px;
    font-size: 0.875rem;
  }

  .ft-meta p {
    display: flex;
    flex-wrap: wrap;
    gap: 0 20px;
  }

  .ft-meta a {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .ft-top {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    min-height: 44px;
    padding-inline: 1rem;
    border: 1px solid rgba(255, 255, 255, 0.55);
    border-radius: 999px;
    color: #fff;
    font-weight: 700;
  }

  .ft-top:hover {
    background: rgba(255, 255, 255, 0.1);
  }

  .ft-top :global(svg) {
    transform: rotate(180deg);
  }

  /* スマホ：紹介のまとまりを小さくして、リンクまでの距離を縮める */
  @media (max-width: 599px) {
    .ft-main {
      gap: 24px;
      padding-block: 32px 28px;
    }

    .ft-logo {
      min-height: 44px;
    }

    .ft-logo img {
      height: 36px;
    }

    .ft-catch {
      margin-top: 0.6rem;
      font-size: 1.0625rem;
    }

    .ft-about {
      margin-top: 0.4rem;
      font-size: 0.875rem;
      line-height: 1.65;
    }

    .ft-climate {
      margin-top: 0.9rem;
      padding: 10px 12px;
    }

    .ft-sns {
      margin-top: 0.9rem;
    }

    .ft-cols {
      display: none;
    }

    .ft-acc {
      display: block;
      border-bottom: 1px solid rgba(255, 255, 255, 0.22);
    }

    .ft-acc details {
      border-top: 1px solid rgba(255, 255, 255, 0.22);
    }

    .ft-acc summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      min-height: 46px;
      color: #fff;
      font-size: 0.9375rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      list-style: none;
      cursor: pointer;
    }

    .ft-acc summary::-webkit-details-marker {
      display: none;
    }

    .ft-acc summary :global(svg) {
      flex-shrink: 0;
      opacity: 0.85;
      transition: transform 0.15s;
    }

    .ft-acc details[open] summary :global(svg) {
      transform: rotate(180deg);
    }

    .ft-acc ul {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0 16px;
      padding-bottom: 10px;
      list-style: none;
    }

    .ft-acc a {
      display: block;
      padding-block: 9px;
      font-size: 0.875rem;
      line-height: 1.45;
    }

    .ft-acc a :global(svg) {
      display: inline-block;
      margin-left: 0.3em;
      vertical-align: -0.08em;
      opacity: 0.8;
    }

    .ft-legal {
      display: flex;
      flex-wrap: wrap;
      gap: 0 16px;
      margin-top: -12px;
      list-style: none;
    }

    .ft-legal a {
      display: inline-block;
      padding-block: 6px;
      font-size: 0.8125rem;
      text-decoration: underline;
      text-underline-offset: 0.25em;
    }

    .ft-bottom-in {
      padding-block: 14px;
    }
  }

  @media (max-width: 599px) and (prefers-reduced-motion: reduce) {
    .ft-acc summary :global(svg) {
      transition: none;
    }
  }

  @media (min-width: 700px) {
    .ft-col {
      display: grid;
      grid-template-columns: 8.5em minmax(0, 1fr);
      gap: 0 16px;
      align-items: start;
      padding-block: 6px;
    }

    .ft-col a {
      padding-block: 4px;
    }
  }

  @media (min-width: 1100px) {
    .ft-main {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 2.15fr);
    }
  }
</style>
