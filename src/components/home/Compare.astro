---
/**
 * 「自分で用意する場合」との比較表。
 * 列＝手段、行＝比べる観点。ASHIKA Network の列だけ濃紺の縁で囲う。
 * データは src/data/compare.ts。
 */
import Icon from '../Icon.astro';
import { alternatives } from '../../data/compare';

const selfIndex = alternatives.selfColumn; // ASHIKA Network の列（色を付ける）
---

<section id="compare" class="section band compare" aria-labelledby="compare-title">
  <div class="container">
    <div class="sec-head" data-reveal>
      <h2 id="compare-title">{alternatives.title}</h2>
      <p class="lead">{alternatives.lead}</p>
    </div>

    <p class="scroll-hint" data-reveal>
      <Icon name="swipe" size={16} />
      {alternatives.scrollHint}
    </p>

    <div class="alt-scroll" data-reveal style="--d:.1s">
      <table class="alt-table">
        <thead>
          <tr>
            <th scope="col"><span class="sr-only">{alternatives.itemAria}</span></th>
            {alternatives.columns.map((c, i) => <th scope="col" class:list={[i === selfIndex && 'self']}>{c}</th>)}
          </tr>
        </thead>
        <tbody data-stagger>
          {
            alternatives.rows.map((r) => (
              <tr>
                <th scope="row">{r.label}</th>
                {r.cells.map((c, i) => (
                  <td class:list={[i === selfIndex && 'self']} data-col={alternatives.columns[i]}>
                    {c}
                  </td>
                ))}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <ul class="notes">
      {alternatives.notes.map((n) => <li>{n}</li>)}
    </ul>
  </div>
</section>

<style>
  /*
   * 他社比較。数字を並べて見せる表なので、装飾は足さず罫線と余白だけで組む。
   * 自社の列だけ濃紺の縁で囲い、見出しを反転させる。
   */
  .matrix-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-top: clamp(22px, 3.5vw, 34px);
  }

  .scroll-hint {
    display: flex;
    align-items: center;
    gap: 0.4em;
    font-size: 0.76rem;
    color: var(--ink-3);
  }

  .scroll-hint svg {
    color: var(--b-mid);
  }

  .tax {
    font-size: 0.76rem;
    color: var(--ink-3);
  }

  @media (min-width: 900px) {
    .scroll-hint {
      display: none;
    }
  }

  /* ---------- 表の共通部分 ---------- */
  .matrix-scroll,
  .alt-scroll {
    margin-top: 0.7rem;
    overflow-x: auto;
    border-radius: var(--r-lg);
  }

  .matrix,
  .alt-table {
    width: 100%;
    min-width: 620px;
    border-collapse: separate;
    border-spacing: 0;
    background: var(--bg);
    font-size: 0.85rem;
  }

  .matrix th,
  .matrix td,
  .alt-table th,
  .alt-table td {
    padding: 0.7rem 0.9rem;
    border-bottom: 1px solid var(--line);
    text-align: center;
    vertical-align: middle;
  }

  .matrix thead th,
  .alt-table thead th {
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line-2);
    background: var(--surface);
  }

  .matrix tbody th,
  .alt-table tbody th,
  .matrix .corner {
    text-align: left;
    white-space: nowrap;
    font-weight: 700;
    color: var(--ink-2);
    background: var(--surface);
    border-right: 1px solid var(--line);
    width: 9em;
  }

  .matrix thead th:first-child,
  .alt-table thead th:first-child {
    border-left: 1px solid var(--line);
  }

  .matrix thead th:last-child,
  .matrix tbody td:last-child,
  .alt-table thead th:last-child,
  .alt-table tbody td:last-child {
    border-right: 1px solid var(--line);
  }

  /* 自社の列 */
  .matrix th.self,
  .matrix td.self,
  .alt-table th.self,
  .alt-table td.self {
    border-left: 1px solid var(--b);
    border-right: 1px solid var(--b);
    background: var(--b-tint);
  }

  .matrix thead th.self,
  .alt-table thead th.self {
    background: var(--b);
    color: #fff;
    border-top: 1px solid var(--b);
  }

  .matrix tbody tr:last-child td.self,
  .alt-table tbody tr:last-child td.self {
    border-bottom: 1px solid var(--b);
  }

  .who-name {
    display: block;
    font-weight: 800;
    font-size: 0.88rem;
  }

  .who-note {
    display: block;
    margin-top: 0.15rem;
    font-size: 0.7rem;
    font-weight: 500;
    color: var(--ink-3);
    line-height: 1.6;
  }

  .matrix thead th.self .who-note {
    color: rgba(255, 255, 255, 0.8);
  }

  /* ---------- 金額のセル ---------- */
  .cell {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
  }

  .price {
    display: flex;
    align-items: baseline;
    gap: 0.1em;
  }

  .price .amt {
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  .self .price .amt {
    color: var(--b);
    font-size: 1.2rem;
    font-weight: 900;
  }

  .price .unit {
    font-size: 0.72rem;
    color: var(--ink-3);
  }

  .approx {
    font-size: 0.7rem;
    color: var(--ink-3);
  }

  .none {
    color: var(--line-2);
  }

  .notes {
    margin-top: 0.9rem;
    list-style: none;
    display: grid;
    gap: 0.25rem;
    font-size: 0.74rem;
    line-height: 1.8;
    color: var(--ink-3);
  }

  /* ---------- 他の方法との比較 ---------- */
  .alt {
    margin-top: clamp(40px, 6vw, 72px);
    padding-top: clamp(28px, 4vw, 44px);
    border-top: 1px solid var(--line);
  }

  .alt h3 {
    padding-left: clamp(12px, 2vw, 18px);
    border-left: 3px solid var(--b);
    font-size: clamp(1.15rem, 2.2vw, 1.5rem);
    font-weight: 900;
  }

  .alt-lead {
    margin-top: 0.7rem;
    font-size: 0.88rem;
  }

  .alt-hint {
    margin-top: 1rem;
  }

  .alt-table tbody td {
    line-height: 1.7;
    font-size: 0.82rem;
  }

  .alt-table td.self {
    font-weight: 700;
    color: var(--ink);
  }
</style>
