---
/**
 * 国内のホスティング各社を、メモリ1GBあたりの月額で並べる表。
 * 行＝サービス。ASHIKA Network の行だけ太い枠で囲い、金額にマーカーを引く。1GBあたりの額は横棒でも見せる。
 * 幅 600〜859px では、1行を1つの札に組み替える（横にスクロールさせない）。
 * スマホ（600px 未満）では、3列の小さな表にする。6行が1画面に入るので、いちばん上と下をそのまま比べられる。
 *   「比べたプラン」は列にせず、サービス名の下に小さく入れる。
 * データと比べ方の決まりは src/data/compare.ts。
 */
import { content } from '../../data/index';
import { langOf } from '../../i18n';

const lang = langOf(Astro.url);
const { alternatives } = content(lang).compare;
const { sectionLabels, notes } = content(lang).home;
const money = (n: number) => (lang === 'en' ? `¥${n.toLocaleString('en-US')}` : `${n.toLocaleString('ja-JP')}円`);
const max = Math.max(...alternatives.rows.map((r) => r.perGb));
---

<section id="compare" class="section band compare" aria-labelledby="compare-title">
  <div class="container">
    <div class="sec-head">
      <p class="sec-label">{sectionLabels.compare}</p>
      <h2 id="compare-title">{alternatives.title}</h2>
      <p class="lead">{alternatives.lead}</p>
    </div>

    <table class="cmp">
      <thead>
        <tr>
          {alternatives.columns.map((c, i) => (
            <th scope="col">
              <span class="c-full">{c}</span>
              <span class="c-short">{alternatives.columnsShort[i]}</span>
            </th>
          ))}
        </tr>
      </thead>
      <tbody>
        {
          alternatives.rows.map((r) => (
            <tr class:list={[r.self && 'self']}>
              <th scope="row">
                {r.name}
                <span class="plan-s">{r.plan}</span>
              </th>
              <td class="plan">{r.plan}</td>
              <td class="month">
                <span class="m-label">{alternatives.columns[2]}</span>
                <span class="val">
                  <span class="num">{money(r.monthly)}</span>
                  <span class="unit">{alternatives.perMonth}</span>
                </span>
                <span class="tax">{r.tax}</span>
              </td>
              <td class="per">
                <span class="m-label">{alternatives.columns[3]}</span>
                <span class="val">
                  <span class:list={['num', r.self && 'mk']}>{money(r.perGb)}</span>
                  <span class="unit">{alternatives.perMonth}</span>
                </span>
                <span class="gauge" aria-hidden="true">
                  <span style={`width:${(r.perGb / max) * 100}%`} />
                </span>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>

    <p class="notes">
      {alternatives.short}
      <a href="#notes">{notes.link}</a>
    </p>
  </div>
</section>

<style>
  .cmp {
    width: 100%;
    margin-top: clamp(28px, 4vw, 48px);
    border-collapse: separate;
    border-spacing: 0 8px;
    text-align: left;
  }

  .cmp thead th {
    padding: 0 16px 4px;
    font-size: 0.875rem;
    color: var(--ink-3);
    font-weight: 700;
  }

  .cmp tbody th,
  .cmp td {
    padding: 14px 16px;
    background: var(--bg);
    border-block: 1px solid var(--line);
    vertical-align: middle;
  }

  .cmp tbody th {
    border-left: 1px solid var(--line);
    border-radius: var(--r) 0 0 var(--r);
    color: var(--ink);
    white-space: nowrap;
  }

  .cmp td:last-child {
    border-right: 1px solid var(--line);
    border-radius: 0 var(--r) var(--r) 0;
    width: 34%;
  }

  .cmp .self th,
  .cmp .self td {
    border-block: 3px solid var(--b);
    background: var(--b-tint);
  }

  .cmp .self th {
    border-left: 3px solid var(--b);
    color: var(--b-deep);
    font-size: 1.0625rem;
  }

  .cmp .self td:last-child {
    border-right: 3px solid var(--b);
  }

  .plan {
    font-size: 0.9375rem;
  }

  .m-label {
    display: none;
    font-size: 0.875rem;
    color: var(--ink-3);
  }

  .val {
    display: inline-flex;
    align-items: baseline;
    white-space: nowrap;
    color: var(--ink);
  }

  .month .num {
    font-size: 1.125rem;
    font-weight: 700;
  }

  .per .num {
    font-size: 1.5rem;
  }

  .self .per .num {
    font-size: 2rem;
  }

  .unit {
    margin-left: 0.15em;
    font-size: 0.875rem;
  }

  .tax {
    display: block;
    font-size: 0.875rem;
    color: var(--ink-3);
    line-height: 1.5;
  }

  .gauge {
    display: block;
    height: 10px;
    margin-top: 6px;
    border-radius: 5px;
    background: var(--surface-2);
    overflow: hidden;
  }

  .gauge span {
    display: block;
    height: 100%;
    border-radius: 5px;
    background: var(--line-2);
  }

  .self .gauge span {
    background: var(--b);
  }

  .notes {
    margin-top: 1.25rem;
    font-size: 0.875rem;
    color: var(--ink-3);
    line-height: 1.7;
  }

  /* スマホの表でだけ、サービス名の下に出す「比べたプラン」 */
  /* スマホ用の短い見出し */
  .c-short {
    display: none;
  }

  .plan-s {
    display: none;
  }

  /* 幅 600〜859px：1行を1つの札にする */
  @media (min-width: 600px) and (max-width: 859px) {
    .cmp,
    .cmp tbody {
      display: block;
    }

    /* 列の見出しは各マスの中に小さく出す（読み上げには残す） */
    .cmp thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
    }

    .cmp tr {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-areas: 'name name' 'plan plan' 'month per';
      gap: 6px 16px;
      padding: 16px;
      margin-bottom: 10px;
      border: 1px solid var(--line);
      border-radius: var(--r);
      background: var(--bg);
    }

    .cmp tr.self {
      border: 3px solid var(--b);
      background: var(--b-tint);
    }

    .cmp tbody th,
    .cmp td,
    .cmp .self th,
    .cmp .self td,
    .cmp .self td:last-child,
    .cmp td:last-child {
      display: block;
      width: auto;
      padding: 0;
      border: 0;
      border-radius: 0;
      background: none;
    }

    .cmp tbody th {
      grid-area: name;
      white-space: normal;
      font-size: 1.0625rem;
    }

    .plan {
      grid-area: plan;
    }

    .month {
      grid-area: month;
    }

    .per {
      grid-area: per;
    }

    .m-label {
      display: block;
    }
  }

  /* スマホ：3列の表（サービス｜月額｜メモリ1GBあたり）。列の幅を決めておき、数字の右端をそろえる */
  @media (max-width: 599px) {
    .cmp {
      table-layout: fixed;
      margin-top: 16px;
      border-spacing: 0;
      font-size: 0.929rem;
      line-height: 1.4;
    }

    .cmp thead th {
      padding: 0 0 5px 8px;
      border-bottom: 1px solid var(--line-2);
      font-size: 0.786rem;
      font-weight: 400;
      line-height: 1.3;
      text-align: right;
      vertical-align: bottom;
    }

    .cmp thead th:first-child {
      padding-left: 10px;
      text-align: left;
    }

    .c-full {
      display: none;
    }

    .c-short {
      display: inline;
      white-space: nowrap;
    }

    .cmp thead th:nth-child(2),
    .cmp td.plan {
      display: none;
    }

    .cmp thead th:nth-child(3) {
      width: 5.8rem;
    }

    .cmp thead th:nth-child(4) {
      width: 7rem;
      padding-right: 10px;
    }

    .cmp tbody th,
    .cmp td,
    .cmp .self th,
    .cmp .self td {
      padding: 9px 0 9px 8px;
      border: 0;
      border-bottom: 1px solid var(--line);
      border-radius: 0;
      vertical-align: top;
    }

    .cmp tbody th,
    .cmp .self th {
      padding-left: 10px;
      font-size: 0.929rem;
      white-space: normal;
    }

    .cmp td:last-child,
    .cmp .self td:last-child {
      width: auto;
      padding-right: 10px;
      border-right: 0;
      border-radius: 0;
    }

    .cmp .self th {
      box-shadow: inset 3px 0 0 var(--b);
    }

    .plan-s {
      display: block;
      margin-top: 1px;
      color: var(--ink-3);
      font-size: 0.786rem;
      font-weight: 400;
      line-height: 1.45;
    }

    .cmp td.month,
    .cmp td.per {
      text-align: right;
    }

    .month .num {
      font-size: 0.929rem;
    }

    .tax {
      font-size: 0.714rem;
      line-height: 1.4;
    }

    .per .num {
      font-size: 1.143rem;
    }

    .self .per .num {
      font-size: 1.429rem;
    }

    .unit {
      font-size: 0.786rem;
    }

    .gauge {
      height: 4px;
      margin-top: 4px;
    }

    .notes {
      margin-top: 12px;
      font-size: 0.857rem;
      line-height: 1.6;
    }
  }
</style>
