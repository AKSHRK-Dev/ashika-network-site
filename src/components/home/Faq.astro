---
/**
 * よくある質問。ブラウザ標準の <details> を使う（JS なしで開閉でき、キーボードでも読み上げでもそのまま扱える）。
 */
import Icon from '../Icon.astro';
import { content } from '../../data/index';
import { langOf, localize } from '../../i18n';

const lang = langOf(Astro.url);
const { faq, sectionLabels } = content(lang).home;
---

<section id="faq" class="section" aria-labelledby="faq-title">
  <div class="container in">
    <div class="head">
      <p class="sec-label">{sectionLabels.faq}</p>
      <h2 id="faq-title" class="sec-h2">{faq.title}</h2>
      <div class="actions">
        <a class="btn btn-outline" href={localize(faq.more.href, lang)}>
          {faq.more.label}
          <Icon name="arrow" class="arrow" />
        </a>
        <a class="btn btn-outline" href={faq.button.href} target="_blank" rel="noopener">
          <Icon name="discord" />
          {faq.button.label}
        </a>
      </div>
    </div>

    <div class="list">
      {
        faq.items.map((item) => (
          <details class="qa">
            <summary>
              <span class="q num" aria-hidden="true">Q</span>
              <span class="t">{item.q}</span>
              <Icon name="chevron" class="chev" size={20} />
            </summary>
            <p class="a">{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .in {
    display: grid;
    gap: clamp(24px, 4vw, 56px);
    align-items: start;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 1.5rem;
  }

  .list {
    border-top: 1px solid var(--line-2);
  }

  .qa {
    border-bottom: 1px solid var(--line-2);
  }

  .qa summary {
    display: grid;
    grid-template-columns: 32px minmax(0, 1fr) 20px;
    align-items: center;
    gap: 12px;
    min-height: 64px;
    padding-block: 0.9rem;
    color: var(--ink);
    font-weight: 700;
    font-size: 1.0625rem;
    line-height: 1.55;
    cursor: pointer;
    list-style: none;
  }

  .qa summary::-webkit-details-marker {
    display: none;
  }

  .qa summary:hover .t {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .q {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--b-tint);
    color: var(--b);
  }

  .qa :global(.chev) {
    color: var(--ink-3);
    transition: transform 0.2s var(--ease);
  }

  .qa[open] :global(.chev) {
    transform: rotate(180deg);
  }

  .a {
    padding: 0 0 1.25rem 44px;
    max-width: 46em;
  }

  @media (min-width: 960px) {
    .in {
      grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
    }

    .head {
      position: sticky;
      top: calc(var(--header-h) + 72px);
    }
  }

  @media (max-width: 480px) {
    .a {
      padding-left: 0;
    }
  }

  /* スマホ：質問の行を低くし、2つのボタンは入るかぎり横に並べる（入らない幅では縦に積む） */
  @media (max-width: 599px) {
    .in {
      gap: 16px;
    }

    .actions {
      gap: 8px;
      margin-top: 0.9rem;
    }

    .actions .btn {
      flex: 1 1 auto;
      padding-inline: 0.8rem;
      font-size: 0.875rem;
    }

    .qa summary {
      grid-template-columns: 26px minmax(0, 1fr) 18px;
      gap: 10px;
      min-height: 52px;
      padding-block: 0.6rem;
      font-size: 0.9375rem;
    }

    .q {
      width: 26px;
      height: 26px;
      font-size: 0.875rem;
    }

    .a {
      padding-bottom: 1rem;
    }
  }
</style>
