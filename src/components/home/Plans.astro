---
/**
 * 料金。種類はタブで切り替え、月額と3ヶ月契約は2つのボタンで切り替える（押されているほうに aria-pressed）。
 *
 * 幅 600px 以上：プランを札（カード）で並べる。札のいちばん下のボタンからお申し込みへ進む。
 * スマホ（600px 未満）：札をやめて、1つの表にする。上から下まで1画面に入るので、行どうしをそのまま比べられる。
 *   行を押すとそのプランが選ばれ、表のすぐ下に金額・向いている用途・お申し込みのボタンが出る。
 *   種類のタブは表の上に貼りついて残る（下の行を見ているときも、戻らずに切り替えられる）。
 */
import Icon from '../Icon.astro';
import { content } from '../../data/index';
import { langOf } from '../../i18n';

const { plans, specLabels, sectionLabels, notes } = content(langOf(Astro.url)).home;

const perMonth = (quarterly: number) => Math.round((quarterly / 3) * 10) / 10;

/**
 * 3ヶ月契約にしたときの最大の割引率（%）。料金データから計算する。
 * 「要問い合わせ」のプラン（monthly が null）は金額がないので計算から外す。
 */
const priced = plans.kinds.flatMap((k) => plans.list[k.key]).filter((p) => p.monthly !== null && p.quarterly !== null);
const maxDiscount = priced.length
  ? Math.max(...priced.map((p) => Math.round((1 - p.quarterly! / (p.monthly! * 3)) * 100)))
  : 0;
const badge = maxDiscount > 0 ? plans.badge(maxDiscount) : plans.badgeNone;
const L = plans.labels;

/** スマホの表では、桁をそろえて比べやすいように、1024MB の倍数を GB に直す（1024MB → 1GB） */
const short = (v: string) => {
  const m = /^(\d+)MB$/.exec(v);
  return m && Number(m[1]) % 1024 === 0 ? `${Number(m[1]) / 1024}GB` : v;
};
const yen = (n: number) => `¥${n.toLocaleString('en-US')}`;
/** タブの名前を「標準」と「プラン」に分ける。スマホでは後ろの「プラン」を出さず、4つを1行に並べる */
const tabParts = (label: string) => {
  const m = /^(.*?)(\s*プラン)$/.exec(label);
  return m ? [m[1], m[2]] : [label, ''];
};
---

<section id="plans" class="section plans" aria-labelledby="plans-title" data-term="monthly">
  <div class="container" data-tabs>
    <div class="sec-head">
      <p class="sec-label">{sectionLabels.plans}</p>
      <h2 id="plans-title">{plans.title.join('')}</h2>
      {plans.lead.length > 0 && <p class="lead">{plans.lead.join('')}</p>}
    </div>

    <div class="zone" data-zone>
    <div class="ctl">
      <div class="kinds" role="tablist" aria-label={L.kindsAria}>
        {
          plans.kinds.map((k, i) => (
            <button
              type="button"
              role="tab"
              id={`plans-tab-${k.key}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              aria-controls={`plans-${k.key}`}
              tabindex={i === 0 ? 0 : -1}
            >
              {tabParts(k.label)[0]}
              {tabParts(k.label)[1] && <span class="k-suf">{tabParts(k.label)[1]}</span>}
            </button>
          ))
        }
      </div>

      <div class="term" role="group" aria-label={`${plans.terms.monthly} / ${plans.terms.quarterly}`}>
        <button type="button" data-term-btn="monthly" aria-pressed="true">{plans.terms.monthly}</button>
        <button type="button" data-term-btn="quarterly" aria-pressed="false">
          {plans.terms.quarterly}
          <span class="save">{badge}</span>
        </button>
      </div>
    </div>

    {
      plans.kinds.map((k, ki) => (
        <div class="kind" id={`plans-${k.key}`} role="tabpanel" aria-labelledby={`plans-tab-${k.key}`} hidden={ki !== 0}>
          <p class="kind-desc">{k.desc}</p>
          <ul class="cards">
            {plans.list[k.key].map((p) => {
              const ask = p.monthly === null || p.quarterly === null;
              return (
                <li class:list={['card', p.hot && 'hot']}>
                  {p.hot && <p class="hot-mark">{L.hot}</p>}
                  <h3>{p.name}</h3>
                  {ask ? (
                    <div class="price-box">
                      <p class="ask">{L.ask.price}</p>
                      <p class="pnote">{L.ask.note}</p>
                    </div>
                  ) : (
                    <div class="price-box">
                      <p class="price" data-term-show="monthly">
                        <span class="yen">¥</span>
                        <span class="num mk">{p.monthly}</span>
                        <span class="unit">{L.unit.monthly}</span>
                      </p>
                      <p class="price" data-term-show="quarterly">
                        <span class="yen">¥</span>
                        <span class="num mk">{p.quarterly}</span>
                        <span class="unit">{L.unit.quarterly}</span>
                      </p>
                      <p class="pnote" data-term-show="monthly">
                        {L.note.monthly.before}<b>¥{perMonth(p.quarterly!)}</b>{L.note.monthly.after}
                      </p>
                      <p class="pnote" data-term-show="quarterly">
                        {L.note.quarterly.before}<b>¥{perMonth(p.quarterly!)}</b>{L.note.quarterly.after}
                      </p>
                    </div>
                  )}
                  {p.note && <p class="pstart">{p.note}</p>}
                  <dl class="specs">
                    {specLabels.map((label, si) => (
                      <div>
                        <dt>{label}</dt>
                        <dd>{p.specs[si]}</dd>
                      </div>
                    ))}
                  </dl>
                  <p class="fit">
                    <span class="fit-l">{plans.fitLabel}</span>
                    {p.fit}
                  </p>
                  <a class:list={['btn', p.hot ? 'btn-primary' : 'btn-outline']} href={p.href} target="_blank" rel="noopener">
                    <span class="sr-only">{p.name}: </span>
                    {ask ? L.ask.button : plans.button}
                    <Icon name={ask ? 'discord' : 'arrow'} />
                  </a>
                </li>
              );
            })}
          </ul>

          {(() => {
            const list = plans.list[k.key];
            const rows = list.filter((p) => p.monthly !== null && p.quarterly !== null);
            const first = Math.max(0, list.findIndex((p) => p.hot));
            return (
              <div class="pt" data-pt>
                {rows.length > 0 && (
                  <table class="ptable">
                    <thead>
                      <tr>
                        <th scope="col" class="c-name">{L.plan}</th>
                        <th scope="col">{specLabels[0]}</th>
                        <th scope="col">{specLabels[1]}</th>
                        <th scope="col">{specLabels[2]}</th>
                        <th scope="col" class="c-bk"><span>{specLabels[3]}</span></th>
                        <th scope="col" class="c-price">
                          <span data-term-show="monthly">{plans.terms.monthly}</span>
                          <span data-term-show="quarterly">{plans.terms.quarterly}</span>
                        </th>
                      </tr>
                    </thead>
                    <tbody>
                      {list.map((p, pi) =>
                        p.monthly === null || p.quarterly === null ? null : (
                          <tr data-pt-row={pi} data-on={pi === first ? '' : undefined}>
                            <th scope="row" class="c-name">
                              <button type="button" aria-pressed={pi === first ? 'true' : 'false'} aria-controls={`pt-${k.key}-${pi}`}>
                                <span class="pt-n">
                                  <span class="pt-name">{p.name}</span>
                                  {p.hot && <span class="pt-hot">{L.hot}</span>}
                                </span>
                              </button>
                            </th>
                            <td>{short(p.specs[0])}</td>
                            <td>{p.specs[1]}</td>
                            <td>{short(p.specs[2])}</td>
                            <td class="c-bk">{p.specs[3]}</td>
                            <td class="c-price">
                              <span class="num" data-term-show="monthly">{yen(p.monthly)}</span>
                              <span class="num" data-term-show="quarterly">{yen(p.quarterly)}</span>
                            </td>
                          </tr>
                        ),
                      )}
                    </tbody>
                  </table>
                )}

                {list.map((p, pi) => {
                  const ask = p.monthly === null || p.quarterly === null;
                  return (
                    <div class="pt-d" id={`pt-${k.key}-${pi}`} data-pt-detail={pi} hidden={rows.length > 0 && pi !== first}>
                      <div class="pt-d-top">
                        <p class="pt-d-name">{p.name}</p>
                        {ask ? (
                          <p class="pt-d-price pt-d-ask">{L.ask.price}</p>
                        ) : (
                          <Fragment>
                            <p class="pt-d-price" data-term-show="monthly">
                              <span class="num mk">{yen(p.monthly!)}</span>
                              <span class="unit">{L.unit.monthly}</span>
                            </p>
                            <p class="pt-d-price" data-term-show="quarterly">
                              <span class="num mk">{yen(p.quarterly!)}</span>
                              <span class="unit">{L.unit.quarterly}</span>
                            </p>
                          </Fragment>
                        )}
                      </div>
                      <p class="pt-d-fit">{p.fit}</p>
                      {ask ? (
                        <p class="pt-d-note">{L.ask.note}</p>
                      ) : (
                        <Fragment>
                          <p class="pt-d-note" data-term-show="monthly">
                            {L.note.monthly.before}<b>¥{perMonth(p.quarterly!)}</b>{L.note.monthly.after}
                          </p>
                          <p class="pt-d-note" data-term-show="quarterly">
                            {L.note.quarterly.before}<b>¥{perMonth(p.quarterly!)}</b>{L.note.quarterly.after}
                          </p>
                        </Fragment>
                      )}
                      {!ask && <p class="pt-d-note pt-d-bk">{specLabels[3]} {p.specs[3]}</p>}
                      {p.note && <p class="pt-d-note">{p.note}</p>}
                      <a class:list={['btn', ask ? 'btn-outline' : 'btn-primary']} href={p.href} target="_blank" rel="noopener">
                        <span class="sr-only">{p.name}: </span>
                        {ask ? L.ask.button : plans.button}
                        <Icon name={ask ? 'discord' : 'arrow'} />
                      </a>
                    </div>
                  );
                })}
              </div>
            );
          })()}
        </div>
      ))
    }
    </div>

    <p class="plans-note">
      {plans.note.join('')}
      <a href="#notes">{notes.link}</a>
    </p>

    <a class="support" href={plans.support.href} target="_blank" rel="noopener">
      <span class="support-text">
        <b>{plans.support.title}</b>
        {plans.support.text && <span>{plans.support.text}</span>}
      </span>
      <span class="support-link">
        {plans.support.label}
        <Icon name="external" size={16} />
      </span>
    </a>
  </div>
</section>

<script>
  /* 月額／3ヶ月契約の切り替え。セクションの data-term を変え、表示は CSS が切り替える */
  const sec = document.getElementById('plans');
  const btns = sec?.querySelectorAll<HTMLButtonElement>('[data-term-btn]') ?? [];
  btns.forEach((b) =>
    b.addEventListener('click', () => {
      sec!.dataset.term = b.dataset.termBtn;
      btns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    }),
  );

  /* スマホの表：行を押すとそのプランを選び、表の下の案内（金額・用途・ボタン）を入れ替える */
  sec?.querySelectorAll<HTMLElement>('[data-pt]').forEach((pt) => {
    const rows = Array.from(pt.querySelectorAll<HTMLElement>('[data-pt-row]'));
    const details = Array.from(pt.querySelectorAll<HTMLElement>('[data-pt-detail]'));
    if (!rows.length) return;
    rows.forEach((row) =>
      row.addEventListener('click', () => {
        const id = row.dataset.ptRow;
        rows.forEach((r) => {
          const on = r === row;
          r.toggleAttribute('data-on', on);
          r.querySelector('button')?.setAttribute('aria-pressed', String(on));
        });
        details.forEach((d) => (d.hidden = d.dataset.ptDetail !== id));
      }),
    );
  });

  /* 種類のタブが上に貼りついているときに切り替えたら、表の先頭まで戻す（短い表に替わると、表が画面の上に消えるため） */
  const zone = sec?.querySelector<HTMLElement>('[data-zone]');
  zone?.querySelectorAll<HTMLElement>('[role="tab"]').forEach((tab) =>
    tab.addEventListener('click', () => {
      const header = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--header-h')) || 0;
      if (zone.getBoundingClientRect().top < header) zone.scrollIntoView({ block: 'start' });
    }),
  );
</script>

<noscript>
  <style>
    .plans .pt-d[hidden] {
      display: block !important;
    }
  </style>
</noscript>

<style>
  .ctl {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 24px;
    margin-top: clamp(28px, 4vw, 48px);
  }

  .kinds {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
    flex: 1 1 100%;
  }

  .kinds button,
  .term button {
    min-height: 48px;
    padding: 0.4rem 1rem;
    border: 1px solid var(--line-2);
    background: var(--bg);
    color: var(--ink);
    font-weight: 700;
    line-height: 1.35;
  }

  .kinds button {
    border-radius: var(--r);
  }

  .kinds button:hover,
  .term button:hover {
    border-color: var(--b);
    background: var(--b-tint);
  }

  .kinds button[aria-selected='true'],
  .term button[aria-pressed='true'] {
    border-color: var(--night);
    background: var(--night);
    color: #fff;
  }

  .term {
    display: flex;
    flex: 1 1 100%;
  }

  .term button {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.2em 0.6em;
  }

  .term button:first-child {
    border-radius: 999px 0 0 999px;
    border-right: 0;
  }

  .term button:last-child {
    border-radius: 0 999px 999px 0;
  }

  .save {
    padding: 0 0.6em;
    border-radius: 999px;
    background: var(--hl);
    color: var(--ink);
    font-size: 0.875rem;
  }

  .kind-desc {
    margin-top: 1.25rem;
    max-width: 46em;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 204px), 1fr));
    gap: 14px;
    margin-top: 1.5rem;
    list-style: none;
    align-items: stretch;
  }

  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 22px 18px 18px;
    border: 1px solid var(--line-2);
    border-radius: var(--r-lg);
    background: var(--bg);
  }

  .card.hot {
    border: 3px solid var(--b);
    padding: 20px 16px 16px;
    box-shadow: var(--shadow);
  }

  .hot-mark {
    position: absolute;
    top: -15px;
    left: 14px;
    padding: 0.1em 0.9em;
    border-radius: 999px;
    background: var(--b);
    color: #fff;
    font-size: 0.875rem;
    font-weight: 700;
  }

  .card h3 {
    font-size: 1.125rem;
  }

  .price-box {
    margin-top: 0.5rem;
    min-height: 5.6rem;
  }

  .price {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    color: var(--ink);
    line-height: 1.2;
  }

  .price .yen {
    font-size: 1.25rem;
    font-weight: 700;
    margin-right: 0.1em;
  }

  .price .num {
    font-size: 2.75rem;
  }

  .price .unit {
    margin-left: 0.3em;
    font-size: 0.9375rem;
    font-weight: 700;
  }

  .ask {
    color: var(--ink);
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.6;
  }

  .pnote,
  .pstart {
    margin-top: 0.3rem;
    font-size: 0.875rem;
    color: var(--ink-2);
    line-height: 1.5;
  }

  .pnote b {
    color: var(--ink);
  }

  /* 選ばれていない契約期間の金額は出さない */
  .plans[data-term='monthly'] [data-term-show='quarterly'],
  .plans[data-term='quarterly'] [data-term-show='monthly'] {
    display: none;
  }

  .specs {
    margin-top: 0.9rem;
    border-top: 1px solid var(--line);
  }

  .specs > div {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding-block: 0.4rem;
    border-bottom: 1px solid var(--line);
    font-size: 0.9375rem;
  }

  .specs dt {
    color: var(--ink-3);
  }

  .specs dd {
    color: var(--ink);
    font-weight: 700;
    text-align: right;
  }

  .fit {
    display: grid;
    flex: 1;
    align-content: start;
    margin-block: 0.9rem 1rem;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--ink);
  }

  .fit-l {
    font-size: 0.875rem;
    color: var(--ink-3);
  }

  .card .btn {
    width: 100%;
    padding-inline: 0.75rem;
    font-size: 0.9375rem;
  }

  .plans-note {
    margin-top: 1.75rem;
    font-size: 0.875rem;
    color: var(--ink-3);
    line-height: 1.7;
  }

  .support {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    margin-top: 1.5rem;
    padding: 18px 20px;
    border: 1px solid var(--ok-line);
    border-radius: var(--r);
    background: var(--ok-tint);
    color: var(--ink);
  }

  .support:hover {
    border-color: var(--ok);
  }

  .support-text {
    display: grid;
    flex: 1 1 24em;
    font-size: 0.9375rem;
  }

  .support-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    color: var(--ok);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  /* スマホ用の表は、幅 600px 以上では出さない */
  .pt {
    display: none;
  }

  /* ---------- スマホ：札をやめて、1つの表にする ----------
     文字は 11〜14px。表は1画面に入れることを優先する（行を比べるための場所なので）。 */
  @media (max-width: 599px) {
    .zone {
      --kinds-h: 53px;
      margin-top: 14px;
    }

    /* 箱としては使わない（種類のタブを、表の終わりまで上に貼りつけておくため） */
    .ctl {
      display: contents;
    }

    .kinds {
      position: sticky;
      top: var(--header-h);
      z-index: 5;
      display: flex;
      gap: 4px;
      box-sizing: border-box;
      height: var(--kinds-h);
      margin-inline: calc(var(--gutter) * -1);
      padding: 8px var(--gutter);
      border-bottom: 1px solid var(--line);
      background: var(--bg);
    }

    .kinds button {
      flex: 1 1 auto;
      min-height: 36px;
      padding: 0 4px;
      border-color: var(--line);
      border-radius: 8px;
      font-size: 0.857rem;
      white-space: nowrap;
    }

    .k-suf {
      display: none;
    }

    .term {
      justify-content: flex-end;
      margin-top: 10px;
    }

    .term button {
      flex: 0 0 auto;
      min-height: 30px;
      padding: 0 0.9rem;
      border-color: var(--line);
      font-size: 0.857rem;
    }

    /* 金額のない種類（個別見積もり）では、契約期間の切り替えは意味がないので出さない */
    .zone:has(.kind:not([hidden]) .pt:not(:has(.ptable))) .term {
      display: none;
    }

    .save {
      padding: 0 0.5em;
      font-size: 0.786rem;
      line-height: 1.5;
    }

    .kind-desc {
      margin-top: 8px;
      color: var(--ink-3);
      font-size: 0.857rem;
      line-height: 1.6;
    }

    .cards {
      display: none;
    }

    .pt {
      display: block;
      margin-top: 6px;
    }

    .ptable {
      width: 100%;
      border-collapse: separate;
      border-spacing: 0;
      font-size: 0.929rem;
      line-height: 1.35;
    }

    /* 列の見出しは、種類のタブのすぐ下に貼りつく（下の行を見ているときも、どの数字が何か分かるように） */
    .ptable thead th {
      position: sticky;
      top: calc(var(--header-h) + var(--kinds-h));
      z-index: 2;
      padding: 6px 0 5px 6px;
      border-bottom: 1px solid var(--line-2);
      background: var(--bg);
      color: var(--ink-3);
      font-size: 0.786rem;
      font-weight: 400;
      line-height: 1.25;
      text-align: right;
      vertical-align: bottom;
      white-space: nowrap;
    }

    .ptable thead .c-name {
      padding-left: 28px;
      text-align: left;
    }

    /* 「バックアップ」は長いので、3文字ずつ2行に折る（英語の Backups は折らずに1行） */
    .ptable thead .c-bk span {
      display: inline-block;
      width: min-content;
      min-width: 3em;
      white-space: normal;
      text-align: center;
    }

    .ptable td.c-bk {
      text-align: center;
    }

    .ptable tbody th,
    .ptable td {
      padding: 10px 0 10px 6px;
      border-bottom: 1px solid var(--line);
      vertical-align: middle;
    }

    .ptable td {
      color: var(--ink);
      text-align: right;
      white-space: nowrap;
    }

    .ptable tbody .c-name {
      width: 99%;
      text-align: left;
    }

    .ptable .c-price {
      padding-right: 8px;
    }

    .ptable .c-price .num {
      font-size: 1.07rem;
    }

    /* 行のいちばん左：選ぶための丸と、プランの名前 */
    .ptable tbody button {
      display: flex;
      align-items: center;
      gap: 7px;
      width: 100%;
      padding: 0;
      border: 0;
      background: none;
