---
/**
 * お客様パネルの紹介。3つの画面をタブで切り替えて、1枚ずつ大きく見せる。
 */
import { content } from '../../data/index';
import { langOf } from '../../i18n';

const { panel, sectionLabels } = content(langOf(Astro.url)).home;
---

<section id="panel" class="section panel-sec" aria-labelledby="panel-title">
  <div class="container" data-tabs>
    <div class="sec-head">
      <p class="sec-label">{sectionLabels.panel}</p>
      <h2 id="panel-title">{panel.title.join('')}</h2>
      {panel.lead && <p class="lead">{panel.lead}</p>}
    </div>

    <div class="tabs" role="tablist" aria-labelledby="panel-title">
      {
        panel.shots.map((s, i) => (
          <button
            type="button"
            role="tab"
            id={`panel-tab-${i}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            aria-controls={`panel-shot-${i}`}
            tabindex={i === 0 ? 0 : -1}
          >
            <span class="n num" aria-hidden="true">{i + 1}</span>
            {s.title}
          </button>
        ))
      }
    </div>

    {
      panel.shots.map((s, i) => (
        <figure class="shot" role="tabpanel" id={`panel-shot-${i}`} aria-labelledby={`panel-tab-${i}`} hidden={i !== 0}>
          {s.desc && <figcaption>{s.desc}</figcaption>}
          <div class="frame">
            <p class="url" aria-hidden="true">{panel.url}</p>
            <img src={s.src} alt={s.alt} width={panel.width} height={panel.height} loading="lazy" decoding="async" />
          </div>
        </figure>
      ))
    }
  </div>
</section>

<style>
  .tabs {
    display: grid;
    gap: 8px;
    margin-top: clamp(28px, 4vw, 48px);
  }

  .tabs button {
    display: flex;
    align-items: center;
    gap: 0.75em;
    min-height: 56px;
    padding: 0.5rem 1rem;
    border: 1px solid var(--line-2);
    border-radius: var(--r);
    background: var(--bg);
    color: var(--ink);
    font-weight: 700;
    line-height: 1.4;
    text-align: left;
  }

  .tabs button:hover {
    border-color: var(--b);
    background: var(--b-tint);
  }

  .tabs button[aria-selected='true'] {
    border-color: var(--night);
    background: var(--night);
    color: #fff;
  }

  .tabs .n {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--hl);
    color: var(--ink);
    font-size: 0.9375rem;
  }

  .shot {
    margin-top: 16px;
  }

  .shot figcaption {
    max-width: 46em;
    color: var(--ink);
    font-size: 1.0625rem;
  }

  .frame {
    margin-top: 16px;
    border: 2px solid var(--night);
    border-radius: var(--r-lg);
    background: var(--bg);
    overflow: hidden;
    box-shadow: 8px 8px 0 var(--b-tint);
  }

  .url {
    padding: 6px 16px;
    background: var(--night);
    color: #fff;
    font-family: var(--mono);
    font-size: 0.875rem;
    letter-spacing: 0;
  }

  .frame img {
    width: 100%;
  }

  /* スマホ：タブを横に3つ並べ、番号を文の上に置く。とても狭い画面だけ縦に戻す */
  @media (max-width: 599px) {
    .tabs {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 6px;
      margin-top: 20px;
    }

    .tabs button {
      flex-direction: column;
      align-items: flex-start;
      gap: 4px;
      min-height: 0;
      padding: 8px 10px;
      font-size: 0.875rem;
      line-height: 1.4;
    }

    .tabs .n {
      width: 22px;
      height: 22px;
      font-size: 0.875rem;
    }

    .shot {
      margin-top: 12px;
    }

    .shot figcaption {
      font-size: 0.9375rem;
    }

    .frame {
      margin-top: 12px;
      border-radius: var(--r);
      box-shadow: 6px 6px 0 var(--b-tint);
    }

    .url {
      padding: 3px 12px;
    }
  }

  @media (max-width: 359px) {
    .tabs {
      grid-template-columns: minmax(0, 1fr);
    }

    .tabs button {
      flex-direction: row;
      align-items: center;
      gap: 0.6em;
      min-height: 44px;
      padding-block: 4px;
    }
  }

  @media (min-width: 800px) {
    .tabs {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
