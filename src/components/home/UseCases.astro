---
/**
 * できること。4つの用途をタブで切り替える（自動では切り替えない。矢印キーでも動かせる）。
 * 左に見出しと説明とボタン、右に「できること」と「ほかの方法との違い」。
 */
import Icon from '../Icon.astro';
import { content } from '../../data/index';
import { langOf } from '../../i18n';

const { uses, usesLabels, sectionLabels } = content(langOf(Astro.url)).home;
---

<section id="uses" class="section band uses" aria-labelledby="uses-title">
  <div class="container">
    <div class="sec-head">
      <p class="sec-label">{sectionLabels.uses}</p>
      <h2 id="uses-title">{uses.title.join('')}</h2>
      {uses.lead && <p class="lead">{uses.lead}</p>}
    </div>

    <div class="uses-body" data-tabs>
      <div class="tabs" role="tablist" aria-label={uses.tabsAria}>
        {
          uses.items.map((u, i) => (
            <button
              type="button"
              role="tab"
              id={`uc-tab-${i}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              aria-controls={`uc-panel-${i}`}
              tabindex={i === 0 ? 0 : -1}
            >
              {u.label}
            </button>
          ))
        }
      </div>

      {
        uses.items.map((u, i) => (
          <div class="panel" role="tabpanel" id={`uc-panel-${i}`} aria-labelledby={`uc-tab-${i}`} hidden={i !== 0}>
            <div class="main">
              <span class="tag">{u.tag}</span>
              <h3>{u.title.join('')}</h3>
              {u.desc.length > 0 && <p>{u.desc.join('')}</p>}
              <div class="acts">
                <a class="btn btn-primary" href={uses.button.href} target="_blank" rel="noopener">
                  {uses.button.label}
                  <Icon name="arrow" />
                </a>
                {u.guide && (
                  <a class="link guide" href={u.guide.href}>
                    {u.guide.label}
                  </a>
                )}
              </div>
            </div>

            <div class="sub">
              <h4>{usesLabels.points}</h4>
              <ul class="checks">
                {u.points.map((p) => (
                  <li>
                    <Icon name="check" size={20} />
                    {p}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .uses-body {
    margin-top: clamp(28px, 4vw, 48px);
  }

  .tabs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }

  .tabs button {
    min-height: 52px;
    padding: 0.4rem 0.75rem;
    border: 1px solid var(--line-2);
    border-radius: var(--r);
    background: var(--bg);
    color: var(--ink);
    font-weight: 700;
    line-height: 1.35;
  }

  .tabs button:hover {
    border-color: var(--b);
    background: var(--b-tint);
  }

  .tabs button[aria-selected='true'] {
    border-color: var(--night);
    background: var(--night);
    color: #fff;
  }

  .panel {
    display: grid;
    gap: clamp(24px, 4vw, 48px);
    margin-top: 16px;
    padding: clamp(20px, 3.5vw, 40px);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--bg);
  }

  .main h3 {
    margin-top: 0.9rem;
    font-size: clamp(1.4rem, 3vw, 2rem);
  }

  .main > p {
    margin-top: 0.75rem;
  }

  .acts {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 20px;
    margin-top: 1.5rem;
  }

  .guide {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 700;
  }

  .sub h4 {
    font-size: 1rem;
  }

  .checks {
    display: grid;
    gap: 0.5rem;
    margin-top: 0.75rem;
    list-style: none;
  }

  .checks li {
    display: flex;
    gap: 0.6em;
    color: var(--ink);
    font-weight: 700;
  }

  .checks :global(svg) {
    margin-top: 0.25em;
    color: var(--ok);
    flex-shrink: 0;
  }

  .vs {
    display: grid;
    gap: 10px;
    margin-top: 1.5rem;
  }

  .vs > div {
    padding: 14px 16px;
    border-radius: var(--r);
    font-size: 0.9375rem;
  }

  .vs dt {
    font-weight: 700;
    font-size: 0.875rem;
  }

  .vs-before {
    background: var(--surface);
    border: 1px solid var(--line);
  }

  .vs-before dt {
    color: var(--ink-3);
  }

  .vs-after {
    background: var(--b-tint);
    border: 2px solid var(--b);
  }

  .vs-after dt {
    color: var(--b);
  }

  .vs-after dd {
    color: var(--ink);
    font-weight: 700;
  }

  /* スマホ：タブと箱の中を詰める */
  @media (max-width: 599px) {
    .uses-body {
      margin-top: 20px;
    }

    .tabs {
      gap: 6px;
    }

    .tabs button {
      min-height: 44px;
      padding: 0.3rem 0.5rem;
      font-size: 0.875rem;
    }

    .panel {
      gap: 18px;
      margin-top: 10px;
      padding: 16px;
    }

    .main h3 {
      margin-top: 0.6rem;
      font-size: 1.1875rem;
    }

    .main > p {
      margin-top: 0.4rem;
    }

    .acts {
      margin-top: 0.9rem;
    }

    .sub h4 {
      font-size: 0.9375rem;
    }

    .checks {
      gap: 0.25rem;
      margin-top: 0.5rem;
    }

    .checks :global(svg) {
      width: 18px;
      height: 18px;
    }

    .vs {
      gap: 8px;
      margin-top: 1rem;
    }

    .vs > div {
      padding: 10px 12px;
      font-size: 0.875rem;
      line-height: 1.6;
    }
  }

  @media (min-width: 700px) {
    .tabs {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (min-width: 900px) {
    .panel {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }
</style>
