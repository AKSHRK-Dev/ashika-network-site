---
/**
 * 置き場所（大阪・北摂）。左に見出し・説明・項目の一覧、右に大阪府の地図。その下にサーバー本体のスペック。
 * 地図の形は国土数値情報（行政区域、原典は国土地理院の測量成果）で、市町村と区の境界は実際のとおり。
 * データは src/data/osaka-areas.json（tools/osaka-map/build.py で作る）。印の位置・吹き出しの文字は
 * src/data/home.ts の location.map にある。地図は動かさない（色の付く動きはやめた）。
 */
import { content } from '../../data/index';
import { langOf, localize } from '../../i18n';
import { cityCenter, labels, map as geo, placeName, project } from '../../data/osaka-map';

const lang = langOf(Astro.url);
const { location, sectionLabels } = content(lang).home;
const { nodes, specsPage } = content(lang).specs;
/* トップでは所在の行は省く（地図で分かるので） */
const homeRows = (specs: { k: string; v: string }[]) => specs.slice(0, 5);
/* スマホでは、ノードを横に並べた1つの表にする（上下に離れた札どうしは見比べにくいので） */
const compareRows = homeRows(nodes[0].specs).map((s, i) => ({ k: s.k, values: nodes.map((node) => node.specs[i]?.v ?? '') }));

const M = location.map;
const [, , vw, vh] = geo.view;
/* 文字やしるしの大きさは、表示幅の1%を単位にして決める */
const u = vw / 100;
const n = (v: number) => Math.round(v * 10) / 10;

const [px, py] = project(M.pin);
/* 吹き出しは印の左。引き出し線でつなぐ */
const [bx] = project(M.callout);

const map = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${n(vw)} ${n(vh)}" role="img" aria-label="${M.alt}">
  <rect class="sea" width="${n(vw)}" height="${n(vh)}"/>
  <path class="land" d="${geo.land}"/>
  <g class="areas">
    ${geo.areas
      .map(
        (a) =>
          `<path class="city${a.city === M.city ? ' is-here' : ''}" d="${a.d}"><title>${placeName(a.city, a.ward, lang)}</title></path>`,
      )
      .join('')}
  </g>
  <path class="ward-line" d="${geo.lines.ward}" stroke-width="${n(0.1 * u)}"/>
  <path class="city-line" d="${geo.lines.city}" stroke-width="${n(0.24 * u)}"/>
  <path class="pref-line" d="${geo.lines.pref}" stroke-width="${n(0.3 * u)}"/>
  ${labels
    .map((l) => {
      const [x, y] = project(l.at);
      return `<text class="${l.tone}-name" x="${n(x)}" y="${n(y)}" font-size="${n(2 * u)}" text-anchor="middle">${lang === 'en' ? l.en : l.text}</text>`;
    })
    .join('')}
  ${M.bigCities
    .map((name) => {
      const [x, y] = cityCenter(name);
      return `<text class="city-name" x="${n(x)}" y="${n(y)}" font-size="${n(1.7 * u)}" text-anchor="middle">${placeName(name, '', lang)}</text>`;
    })
    .join('')}
  <g class="mark">
    <circle class="ring" cx="${n(px)}" cy="${n(py)}" r="${n(4.2 * u)}"/>
    <line class="leader" x1="${n(bx + 9 * u)}" y1="${n(py)}" x2="${n(px - 1.6 * u)}" y2="${n(py)}" stroke-width="${n(0.28 * u)}"/>
    <circle class="dot" cx="${n(px)}" cy="${n(py)}" r="${n(1.3 * u)}" stroke-width="${n(0.45 * u)}"/>
    <rect class="label-box" x="${n(bx - 9 * u)}" y="${n(py - 4.6 * u)}" width="${n(18 * u)}" height="${n(9.2 * u)}" rx="${n(1.4 * u)}"/>
    <text class="label" x="${n(bx)}" y="${n(py - 0.6 * u)}" font-size="${n(3 * u)}" text-anchor="middle">${M.label}</text>
    <text class="label-sub" x="${n(bx)}" y="${n(py + 3.1 * u)}" font-size="${n(1.9 * u)}" text-anchor="middle">${M.labelSub}</text>
  </g>
</svg>`;
---

<section id="location" class="section band location" aria-labelledby="location-title">
  <div class="container loc-in">
    <div class="loc-copy">
      <p class="sec-label">{sectionLabels.location}</p>
      <h2 id="location-title" class="sec-h2">{location.title.join('')}</h2>
      {location.lead && <p class="lead">{location.lead}</p>}
      <dl class="specs">
        {
          location.specs.map((s) => (
            <div class="row">
              <dt>{s.k}</dt>
              <dd>{s.v}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <figure class="map">
      <Fragment set:html={map} />
    </figure>
  </div>

  <div class="container nodes">
    <h3 class="nodes-h">{location.nodesTitle}</h3>
    <table class="node-table">
      <thead>
        <tr>
          <td></td>
          {
            nodes.map((node) => (
              <th scope="col">
                {node.name}
                <span class="node-id">{node.id}</span>
              </th>
            ))
          }
        </tr>
      </thead>
      <tbody>
        {
          compareRows.map((row) => (
            <tr>
              <th scope="row">{row.k}</th>
              {row.values.map((v) => (
                <td>{v}</td>
              ))}
            </tr>
          ))
        }
      </tbody>
    </table>
    <ul class="node-list">
      {
        nodes.map((node) => (
          <li class="node">
            <p class="node-name">
              {node.name}
              <span class="node-id">{node.id}</span>
            </p>
            <dl>
              {homeRows(node.specs).map((s) => (
                <div class="node-row">
                  <dt>{s.k}</dt>
                  <dd>{s.v}</dd>
                </div>
              ))}
            </dl>
          </li>
        ))
      }
    </ul>
    <p class="nodes-more">
      <a class="link" href={localize('/specs', lang)}>{specsPage.homeLink}</a>
    </p>
  </div>
</section>

<!-- 地図の中身は set:html で入れるので、スコープの付かない書き方にする -->
<style is:global>
  .location .map svg {
    width: 100%;
    height: auto;
    border-radius: var(--r-lg);
    border: 1px solid var(--line);
  }

  .location .map .sea {
    fill: #dfeafa;
  }

  .location .map .land {
    fill: #eef1f5;
  }

  .location .map .pref-line,
  .location .map .city-line,
  .location .map .ward-line {
    fill: none;
    stroke: #fff;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .location .map .ward-line {
    opacity: 0.6;
  }

  .location .map .city {
    fill: #a9c3ea;
  }

  .location .map .city.is-here {
    fill: var(--b);
  }

  .location .map .land-name {
    fill: var(--ink-3);
    font-weight: 700;
  }

  .location .map .sea-name {
    fill: #4d6a92;
    font-weight: 700;
  }

  .location .map .city-name {
    fill: var(--night);
    font-weight: 700;
  }

  .location .map .mark .ring {
    fill: var(--hl);
    opacity: 0.55;
  }

  .location .map .mark .dot {
    fill: var(--hl);
    stroke: var(--night);
  }

  .location .map .mark .leader {
    stroke: var(--night);
  }

  .location .map .mark .label-box {
    fill: var(--night);
  }

  .location .map .mark .label {
    fill: #fff;
    font-weight: 700;
  }

  .location .map .mark .label-sub {
    fill: #e3ebf7;
    font-weight: 700;
  }
</style>

<style>
  .loc-in {
    display: grid;
    gap: clamp(28px, 5vw, 64px);
    align-items: center;
  }

  .lead {
    margin-top: 1rem;
    max-width: 36em;
  }

  .specs {
    margin-top: 1.5rem;
    border-top: 1px solid var(--line-2);
  }

  .row {
    display: grid;
    grid-template-columns: 5.5em minmax(0, 1fr);
    gap: 16px;
    padding-block: 0.8rem;
    border-bottom: 1px solid var(--line);
  }

  .row dt {
    color: var(--ink-3);
    font-weight: 700;
    font-size: 0.9375rem;
  }

  .row dd {
    color: var(--ink);
  }

  .nodes {
    margin-top: clamp(32px, 5vw, 56px);
  }

  .nodes-h {
    font-size: 1.25rem;
  }

  .node-table {
    display: none;
  }

  .node-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: 16px;
    margin-top: 1rem;
    list-style: none;
  }

  .node {
    padding: 20px 22px;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--bg);
  }

  .node-name {
    display: flex;
    align-items: baseline;
    gap: 0.75em;
    color: var(--ink);
    font-size: 1.125rem;
    font-weight: 700;
  }

  .node-id {
    font-family: var(--mono);
    font-size: 0.875rem;
    font-weight: 400;
    color: var(--ink-3);
    letter-spacing: 0;
  }

  .node-row {
    display: grid;
    grid-template-columns: 6em minmax(0, 1fr);
    gap: 12px;
    padding-block: 0.45rem;
    border-top: 1px solid var(--line);
    font-size: 0.9375rem;
  }

  .node dl {
    margin-top: 0.6rem;
  }

  .node-row dt {
    color: var(--ink-3);
  }

  .node-row dd {
    color: var(--ink);
    font-weight: 700;
  }

  .nodes-more {
    margin-top: 0.75rem;
  }

  .nodes-more .link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 700;
  }

  /* スマホ：行の間を詰める。ノードのスペックは札をやめて、横に見比べられる表にする */
  @media (max-width: 599px) {
    .loc-in {
      gap: 20px;
    }

    .lead {
      margin-top: 0.6rem;
    }

    .specs {
      margin-top: 1rem;
    }

    .row {
      gap: 12px;
      padding-block: 0.5rem;
    }

    .row dt {
      font-size: 0.875rem;
      line-height: 1.85;
    }

    .nodes {
      margin-top: 28px;
    }

    .nodes-h {
      font-size: 1.0625rem;
    }

    .node-list {
      display: none;
    }

    .node-table {
      display: table;
      width: 100%;
      margin-top: 0.6rem;
      border-collapse: collapse;
      table-layout: fixed;
      border-top: 2px solid var(--night);
      background: var(--bg);
      font-size: 0.875rem;
      line-height: 1.5;
    }

    .node-table th,
    .node-table td {
      padding: 8px 8px;
      border-bottom: 1px solid var(--line);
      text-align: left;
      vertical-align: top;
    }

    .node-table thead td {
      width: 6.6em;
    }

    .node-table thead th {
      color: var(--ink);
      font-size: 0.9375rem;
    }

    .node-table .node-id {
      display: block;
      font-size: 0.8125rem;
    }

    .node-table tbody th {
      color: var(--ink-3);
      font-weight: 400;
    }

    .node-table tbody td {
      color: var(--ink);
      font-weight: 700;
      overflow-wrap: anywhere;
    }

    .nodes-more {
      margin-top: 0.4rem;
    }
  }

  @media (min-width: 900px) {
    .loc-in {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    }
  }
</style>
