---
/**
 * ロケーション（大阪・北摂）。左に見出し・説明・項目の一覧、右に大阪府の地図。
 * 地図は src/data/osaka-map.ts から組み立てる。自分で起こした図で、他所の
 * 地図データは使っていない。設定（印の位置・吹き出しの文字）は
 * src/data/home.ts の location.map にある。
 */
import { location } from '../../data/home';
import {
  airport,
  areaPath,
  awaji,
  bounds,
  cities,
  cityCells,
  labels,
  land,
  linePath,
  neighborBorders,
  osaka,
  project,
  rawPath,
  rivers,
} from '../../data/osaka-map';

const M = location.map;

/*
 * 大阪府は南北に長いので、左右だけ広めに余白を取って横長に収める。
 * 空いた左側に吹き出しを置く。
 */
const b = bounds(osaka);
const padX = (b.maxX - b.minX) * 0.42;
const padY = (b.maxY - b.minY) * 0.06;
const view = {
  x: b.minX - padX,
  y: b.minY - padY,
  w: b.maxX - b.minX + padX * 2,
  h: b.maxY - b.minY + padY * 2,
};
/* 文字やしるしの大きさは、表示幅の1%を単位にして決める */
const u = view.w / 100;
const n = (v: number) => Math.round(v * 10) / 10;

const cells = cityCells(b);
const [px, py] = project(M.pin);
/* 吹き出しは印の左。引き出し線でつなぐ */
const [bx] = project(M.callout);

const line = n(0.3 * u);

const map = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="${n(view.x)} ${n(view.y)} ${n(view.w)} ${n(view.h)}" role="img" aria-label="${M.alt}">
  <clipPath id="osaka-clip"><path d="${areaPath(osaka)}"/></clipPath>
  <path class="sea" d="M${n(view.x)} ${n(view.y)}h${n(view.w)}v${n(view.h)}h${n(-view.w)}Z"/>
  <path class="land" d="${areaPath(land)}"/>
  <path class="land" d="${areaPath(awaji)}"/>
  ${neighborBorders.map((l) => `<path class="pref-line" d="${linePath(l)}" stroke-width="${line}"/>`).join('')}
  <g clip-path="url(#osaka-clip)">
    ${cells
      .map(
        (c) =>
          `<path class="city${c.name === M.city ? ' is-here' : ''}" d="${rawPath(c.poly)}" stroke-width="${line}"/>`,
      )
      .join('')}
    ${rivers.map((l) => `<path class="river" d="${linePath(l)}" stroke-width="${n(0.3 * u)}"/>`).join('')}
  </g>
  <path class="city" d="${areaPath(airport)}" stroke-width="${line}"/>
  ${labels
    .map((l) => {
      const [x, y] = project(l.at);
      return `<text class="${l.tone}-name" x="${n(x)}" y="${n(y)}" font-size="${n(2 * u)}" text-anchor="middle">${l.text}</text>`;
    })
    .join('')}
  ${cities
    .filter((c) => M.bigCities.includes(c.name))
    .map((c) => {
      const [x, y] = project(c.at);
      return `<text class="city-name" x="${n(x)}" y="${n(y)}" font-size="${n(1.7 * u)}" text-anchor="middle">${c.name}</text>`;
    })
    .join('')}
  <g class="mark">
    <circle class="ring" cx="${n(px)}" cy="${n(py)}" r="${n(4.2 * u)}"/>
    <line class="leader" x1="${n(bx + 9 * u)}" y1="${n(py)}" x2="${n(px - 1.6 * u)}" y2="${n(py)}" stroke-width="${n(0.28 * u)}"/>
    <circle class="dot" cx="${n(px)}" cy="${n(py)}" r="${n(1.3 * u)}" stroke-width="${n(0.45 * u)}"/>
    <rect class="label-box" x="${n(bx - 9 * u)}" y="${n(py - 4.6 * u)}" width="${n(18 * u)}" height="${n(9.2 * u)}" rx="${n(1.4 * u)}"/>
    <text class="label" x="${n(bx)}" y="${n(py - 0.6 * u)}" font-size="${n(3 * u)}" text-anchor="middle">${M.label}</text>
    <text class="label-sub" x="${n(bx)}" y="${n(py + 3.1 * u)}" font-size="${n(1.9 * u)}" text-anchor="middle">${M.labelSub}</text>
  </g>
</svg>`;
---

<section id="location" class="section band location" aria-labelledby="location-title">
  <div class="container loc-in">
    <div class="loc-copy" data-reveal>
      <h2 id="location-title" class="sec-h2">
        {
          location.title.map((line, i) => (
            <>
              {i > 0 && <br />}
              {line}
            </>
          ))
        }
      </h2>
      <p class="lead">{location.lead}</p>
      <dl class="specs">
        {
          location.specs.map((s) => (
            <div class="row">
              <dt>{s.k}</dt>
              <dd>{s.v}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <figure class="map" data-reveal style="--d:.15s">
      <Fragment set:html={map} />
      <figcaption>{location.map.caption}</figcaption>
    </figure>
  </div>
</section>

<style is:global>
  /* 生成したSVGの中身に当てるので global。色はトークンを通す */
  .location .map svg {
    display: block;
    width: 100%;
    height: auto;
    font-family: var(--font);
    font-feature-settings: 'palt';
  }

  .location .map .sea {
    fill: var(--b-tint);
  }

  .location .map .land {
    fill: var(--line);
  }

  /* 隣どうしの府県を分ける線 */
  .location .map .pref-line {
    fill: none;
    stroke: var(--bg);
    stroke-linecap: round;
  }

  /* 市町村。区切りは白い線 */
  .location .map .city {
    fill: var(--b);
    stroke: var(--bg);
    stroke-linejoin: round;
  }

  .location .map .city.is-here {
    fill: var(--b-bright);
  }

  .location .map .river {
    fill: none;
    stroke: var(--b-tint);
    stroke-linecap: round;
    opacity: 0.4;
  }

  .location .map .land-name {
    fill: var(--ink-3);
    font-weight: 700;
  }

  .location .map .sea-name {
    fill: #8ea3bd;
    font-weight: 700;
  }

  .location .map .city-name {
    fill: rgba(255, 255, 255, 0.72);
    font-weight: 700;
  }

  /* ---------- 拠点の印と吹き出し ---------- */
  /* 濃紺の面の上に出るので、輪は白で広げる */
  .location .map .mark .ring {
    fill: var(--bg);
    opacity: 0.22;
  }

  .location .map .mark .dot {
    fill: var(--bg);
    stroke: var(--b-deep);
  }

  .location .map .mark .leader {
    stroke: var(--b-deep);
  }

  .location .map .mark .label-box {
    fill: var(--b-deep);
  }

  .location .map .mark .label {
    fill: #fff;
    font-weight: 800;
  }

  .location .map .mark .label-sub {
    fill: rgba(255, 255, 255, 0.82);
    font-weight: 700;
  }

  /* 表示されたら点が出て、輪が広がり、吹き出しが続く */
  .js .location .map .mark > * {
    opacity: 0;
  }

  .js .location .map.is-in .mark .dot {
    animation: loc-pop 0.5s cubic-bezier(0.34, 1.4, 0.64, 1) forwards;
    transform-box: fill-box;
    transform-origin: center;
  }

  .js .location .map.is-in .mark .ring {
    animation: loc-ring 0.9s var(--ease) forwards;
    transform-box: fill-box;
    transform-origin: center;
  }

  .js .location .map.is-in .mark .leader,
  .js .location .map.is-in .mark .label-box,
  .js .location .map.is-in .mark .label,
  .js .location .map.is-in .mark .label-sub {
    animation: loc-fade 0.5s var(--ease) forwards;
    animation-delay: 0.35s;
  }

  @keyframes loc-pop {
    from {
      opacity: 0;
      transform: scale(0.3);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes loc-ring {
    from {
      opacity: 0;
      transform: scale(0.3);
    }
    to {
      opacity: 0.22;
      transform: none;
    }
  }

  @keyframes loc-fade {
    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .js .location .map .mark > * {
      opacity: 1;
      animation: none;
    }

    .js .location .map .mark .ring {
      opacity: 0.22;
    }
  }
</style>

<style>
  /* 左に説明と項目、右に地図。項目は罫線だけの素の表にする */
  .loc-in {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
    align-items: center;
    gap: clamp(28px, 5vw, 64px);
  }

  .loc-copy .sec-h2 {
    padding-left: clamp(12px, 2vw, 18px);
    border-left: 3px solid var(--b);
    font-size: clamp(1.7rem, 3.6vw, 2.6rem);
    font-weight: 800;
    line-height: 1.35;
  }

  .lead {
    margin-top: 1rem;
    font-size: clamp(0.95rem, 1.4vw, 1.05rem);
    line-height: 1.95;
    max-width: 34em;
  }

  .specs {
    margin-top: 1.6rem;
    border-top: 1px solid var(--line-2);
    max-width: 34em;
  }

  .row {
    display: grid;
    grid-template-columns: 8.5em minmax(0, 1fr);
    gap: 0.2rem 1rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--line-2);
  }

  .row dt {
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--ink-3);
    line-height: 1.7;
  }

  .row dd {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--ink);
  }

  .row:first-child dd {
    color: var(--b-deep);
  }

  /* ---------- 地図 ---------- */
  .map {
    justify-self: center;
    width: min(100%, 700px);
    border: 1px solid var(--line-2);
    border-radius: var(--r-lg);
    overflow: hidden;
    background: var(--b-tint);
  }

  .map figcaption {
    padding: 0.55rem 0.9rem;
    border-top: 1px solid var(--line);
    background: var(--bg);
    font-size: 0.72rem;
    line-height: 1.7;
    color: var(--ink-3);
  }

  @media (max-width: 860px) {
    .loc-in {
      grid-template-columns: 1fr;
    }

    .map {
      width: min(100%, 520px);
    }
  }

  @media (max-width: 480px) {
    .row {
      grid-template-columns: 1fr;
      gap: 0.1rem;
    }
  }
</style>
