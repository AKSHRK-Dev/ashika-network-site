---
/**
 * 最後の申し込みへの誘い。白い面に、太い文字とボタンをひとつ。相談先（Discord）は文字のリンクで添える。
 * 横には、最初の画面でアシカが見上げていた黄色いボールを置き、そこに金額を入れる。
 */
import Icon from '../Icon.astro';
import { content } from '../../data/index';
import { langOf } from '../../i18n';

const lang = langOf(Astro.url);
const { cta } = content(lang).home;
---

<section class="cta-sec" aria-labelledby="cta-title">
  <div class="container cta-in">
    <div class="copy">
      <h2 id="cta-title">
        {
          cta.title.map((line, i) => (
            <span class="line">{i === cta.title.length - 1 ? <span class="mk">{line}</span> : line}</span>
          ))
        }
      </h2>
      <p class="lead">{cta.lead.join(lang === 'en' ? ' ' : '')}</p>
      <div class="actions">
        <a class="btn btn-primary btn-lg" href={cta.primary.href} target="_blank" rel="noopener">
          {cta.primary.label}
          <Icon name="arrow" class="arrow" />
        </a>
        <a class="ask" href={cta.secondary.href} target="_blank" rel="noopener">
          <Icon name="discord" size={20} />
          {cta.secondary.label}
        </a>
      </div>
    </div>

    <p class="ball">
      <span class="b-small">{cta.ball.top}</span>
      <span class="b-fig">
        <span class="num">{cta.ball.value}</span>
        {cta.ball.unit && <span class="b-unit">{cta.ball.unit}</span>}
      </span>
      {cta.ball.bottom.map((line) => <span class="b-small">{line}</span>)}
    </p>
  </div>
</section>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .ball {
      animation: cta-bob 3.4s ease-in-out infinite;
    }
  }

  @keyframes cta-bob {
    50% { translate: 0 -10px; }
  }

  .cta-sec {
    padding-block: clamp(56px, 9vw, 128px);
    border-top: 2px solid var(--ink);
    background: var(--bg);
    --ball: 128px;
  }

  .cta-in {
    display: grid;
    gap: 20px;
  }

  h2 {
    font-size: clamp(2rem, 6.4vw, 4.25rem);
    line-height: 1.3;
    letter-spacing: 0;
  }

  .line {
    display: block;
  }

  .lead {
    max-width: 34em;
    margin-top: 1.25rem;
    color: var(--ink);
    font-size: clamp(1rem, 1.6vw, 1.1875rem);
    font-weight: 700;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 28px;
    margin-top: 2rem;
  }

  .actions .btn {
    min-width: min(100%, 15rem);
  }

  .ask {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    min-height: 44px;
    color: var(--b);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .ask:hover {
    color: var(--b-deep);
    text-decoration-thickness: 2px;
  }

  /* 金額のボール。文字の大きさは、ボールの直径から決める */
  .ball {
    order: -1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: var(--ball);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--hl);
    color: var(--ink);
    font-size: calc(var(--ball) * 0.125);
    font-weight: 700;
    line-height: 1.25;
    text-align: center;
  }

  .b-small {
    font-size: 0.875em;
  }

  .b-fig {
    display: inline-flex;
    align-items: baseline;
    line-height: 1;
  }

  .b-fig .num {
    font-size: 2.7em;
  }

  .b-unit {
    font-size: 1em;
  }

  @media (max-width: 520px) {
    .actions .btn {
      width: 100%;
    }
  }

  /* スマホ：見出しと余白をひとまわり小さくする。ボールの大きさは変えない（中の文字を14pxより小さくしないため） */
  @media (max-width: 599px) {
    .cta-sec {
      padding-block: 40px 44px;
    }

    .cta-in {
      gap: 14px;
    }

    h2 {
      font-size: clamp(1.5rem, 7vw, 1.875rem);
    }

    .lead {
      margin-top: 0.75rem;
      font-size: 0.9375rem;
    }

    .actions {
      gap: 6px 28px;
      margin-top: 1.25rem;
    }
  }

  @media (min-width: 800px) {
    .cta-sec {
      --ball: clamp(220px, 25vw, 330px);
    }

    .cta-in {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: 48px;
    }

    .ball {
      order: 0;
    }
  }
</style>
