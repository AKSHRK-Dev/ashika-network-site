---
/**
 * ヒーロー。濃紺のベタ面に、いちばん大きく「月額30円から！国内最安値」を置き、その下に強みを3つ並べる。
 * 見出しの金額は、表示時に大きい数字から一気に減って最小構成の月額に着地する。
 * 下の白い帯には、ボタンと、見出し・強みの根拠の注記をまとめる。キャッチコピーはフッターにある。
 * 背景は濃紺の単色に、ごく薄い大きな「ASHIKA」の文字を斜めに置いて見切れさせるだけ。
 * 飾りは足さない（グラデーション・枠・影を重ねると、かえって安っぽく見えるため）。
 */
import Icon from '../Icon.astro';
import { content } from '../../data/index';
import { langOf } from '../../i18n';

const lang = langOf(Astro.url);
const { hero } = content(lang).home;

const fmt = (n: number) => n.toLocaleString('ja-JP');

---

<section class="hero" aria-labelledby="hero-title">
  <div class="bg" aria-hidden="true">
    <span class="bg-word">ASHIKA</span>
  </div>
  <div class="container hero-in">
    <!-- 行ごとに .ln で包むと、表示のときに下からせり上がる（global.css の data-anim='lines'） -->
    <h1
      id="hero-title"
      data-reveal
      aria-label={`${hero.headline.before}${fmt(hero.bar.price)}${hero.headline.after} ${hero.headline.second}`}>
      <span class="ln" aria-hidden="true">
        <span style="--n:0">
          {hero.headline.before}<span
            class="h-amt count"
            data-from={hero.bar.from}
            data-to={hero.bar.price}
            data-duration={hero.bar.duration}
            data-delay={hero.countDelay}
           >{fmt(hero.bar.price)}</span>{hero.headline.after}
        </span>
      </span>
      <span class="ln" aria-hidden="true">
        <span style="--n:1" class="h-best">{hero.headline.second}<sup>{hero.headline.mark}</sup></span>
      </span>
    </h1>
    <ul class="points" data-reveal style="--d:.08s">
      {
        hero.points.map((pt) => (
          <li>
            <b>{pt.value}</b>
            <span>
              {pt.label}
              {pt.mark && <sup>{pt.mark}</sup>}
            </span>
          </li>
        ))
      }
    </ul>
    <!-- 文と文の改行はPCだけ。スマホでは自然に折り返す -->
    <p class="lead" data-reveal style="--d:.1s">
      {
        hero.lead.map((line, i) => (
          <>
            {i > 0 && lang === 'en' && ' '}
            {i > 0 && <br class="pc" />}
            {line}
          </>
        ))
      }
    </p>

    <div class="bar" data-reveal style="--d:.2s">
      <p class="bar-note">{hero.bar.note}</p>
      <div class="bar-cta">
        <a class="btn btn-outline btn-lg" href={hero.secondary.href}>{hero.secondary.label}</a>
        <a class="btn btn-primary btn-lg" href={hero.primary.href} target="_blank" rel="noopener">
          {hero.primary.label}<Icon name="arrow" />
        </a>
      </div>
      <p class="bar-foot">{hero.bar.bestNote}<br />{hero.bar.uptimeNote}</p>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: clip;
    background: var(--b-deep);
    color: #fff;
    padding-block: clamp(48px, 7vw, 92px);
  }

  /* ---------- 背景：単色と、薄い「ASHIKA」の文字 ---------- */
  .bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }

  /* 大きく斜めにして、右上で見切れさせる（見出しの右の空いているところ） */
  .bg-word {
    position: absolute;
    right: -0.12em;
    top: -0.06em;
    font-size: clamp(8rem, 26vw, 24rem);
    font-weight: 900;
    letter-spacing: -0.04em;
    line-height: 1;
    color: rgba(255, 255, 255, 0.04);
    transform: rotate(-10deg);
    transform-origin: right top;
    white-space: nowrap;
    user-select: none;
  }

  .hero-in {
    position: relative;
  }

  /* ---------- いちばん大きい見出し（月額30円から！国内最安値） ---------- */
  .hero h1 {
    color: #fff;
    font-size: clamp(2.1rem, 7vw, 4.6rem);
    font-weight: 900;
    line-height: 1.22;
    letter-spacing: -0.015em;
  }

  .h-amt {
    display: inline-block;
    /* 幅は取り置かない（減っている間だけ後ろの文字が少し動くが、止まったときに「月額」との間が空かない） */
    margin-inline: 0.06em;
    font-size: 1.35em;
    line-height: 1;
    color: #8fd0ff;
    font-variant-numeric: tabular-nums;
  }

  .h-best {
    display: inline-block;
  }

  .hero h1 sup,
  .points sup {
    font-size: 0.4em;
    vertical-align: super;
    margin-left: 0.1em;
  }

  .points sup {
    font-size: 0.7em;
  }

  /* ---------- 見出しの下の強み（区切り線だけで並べる） ---------- */
  .points {
    margin-top: clamp(18px, 2.8vw, 26px);
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0;
    list-style: none;
  }

  .points li {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35em;
    padding-right: 1.1em;
    margin-right: 1.1em;
    border-right: 1px solid rgba(255, 255, 255, 0.25);
    font-size: clamp(0.88rem, 1.5vw, 1rem);
    color: rgba(255, 255, 255, 0.8);
  }

  .points li:last-child {
    border-right: 0;
    margin-right: 0;
    padding-right: 0;
  }

  .points b {
    font-size: 1.15em;
    font-weight: 900;
    color: #fff;
  }

  @media (max-width: 560px) {
    .points {
      flex-direction: column;
      gap: 0.35rem;
    }

    .points li {
      border-right: 0;
      margin-right: 0;
      padding-right: 0;
    }
  }

  .hero .lead {
    margin-top: 1.2rem;
    max-width: 64ch;
    font-size: clamp(0.88rem, 1.4vw, 1rem);
    line-height: 1.95;
    color: rgba(255, 255, 255, 0.85);
  }

  .lead .pc {
    display: none;
  }

  /* ---------- 下の白い帯 ---------- */
  .bar {
    margin-top: clamp(26px, 3.8vw, 44px);
    background: var(--bg);
    border-radius: var(--r-lg);
    display: grid;
    gap: 14px;
    padding: 16px clamp(16px, 2.5vw, 24px);
    color: var(--ink);
  }




  .bar-foot {
    grid-column: 1 / -1;
    margin: 0;
    font-size: 0.7rem;
    line-height: 1.6;
    color: var(--ink-3);
  }




  .bar-note {
    margin: 0;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--ink-2);
  }

  .bar-cta {
    display: grid;
    gap: 8px;
  }

  @media (min-width: 560px) {
    .bar-cta {
      grid-auto-flow: column;
      justify-content: start;
    }
  }

  @media (min-width: 860px) {
    .bar {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: 24px;
    }


    .lead .pc {
      display: inline;
    }
  }
</style>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // 見出しの金額が、大きい数字から一気に減って最小構成の月額に着地する
  const counters = document.querySelectorAll<HTMLElement>('.hero .count');
  if (counters.length && !reduce) {
    const fmt = (n: number) => n.toLocaleString('ja-JP');
    counters.forEach((el) => {
      const from = Number(el.dataset.from);
      const to = Number(el.dataset.to);
      const duration = Number(el.dataset.duration) || 1200;
      // 待ち時間と長さは src/data/home.ts の hero（countDelay と bar.duration）から data 属性で渡している
      const delay = Number(el.dataset.delay) || 0;
      el.textContent = fmt(from);
      el.classList.add('is-counting');
      const start = performance.now() + delay;
      const tick = (now: number) => {
        const t = Math.min(1, Math.max(0, (now - start) / duration));
        const eased = 1 - Math.pow(1 - t, 4); // 最初は速く、最後はゆっくり
        el.textContent = fmt(Math.round(from + (to - from) * eased));
        if (t < 1) {
          window.requestAnimationFrame(tick);
        } else {
          el.textContent = fmt(to);
          el.classList.remove('is-counting');
        }
      };
      window.requestAnimationFrame(tick);
    });
  }
</script>
