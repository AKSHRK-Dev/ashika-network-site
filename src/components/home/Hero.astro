---
/**
 * ヒーロー。濃紺のベタ面に、いちばん大きく「月額30円から！国内最安値」を置き、その下に強みを3つ並べる。
 * 見出しの金額は、表示時に大きい数字から一気に減って最小構成の月額に着地する。
 * その下にボタンを紺の面へ直接並べ、根拠の注記は小さく添える（白い箱で囲まない）。
 * PC では右にお客様パネルの画面を置く。キャッチコピーはフッターにある。
 * 背景は濃紺の単色に、ごく薄い大きな「ASHIKA」の文字を斜めに置いて見切れさせるだけ。
 * 飾りは足さない（グラデーション・枠・影を重ねると、かえって安っぽく見えるため）。
 */
import Icon from '../Icon.astro';
import { content } from '../../data/index';
import { langOf } from '../../i18n';

const lang = langOf(Astro.url);
const { hero } = content(lang).home;

const fmt = (n: number) => n.toLocaleString('ja-JP');

---

<section class="hero" aria-labelledby="hero-title">
  <div class="bg" aria-hidden="true">
    <span class="bg-word">ASHIKA</span>
  </div>
  <div class="container hero-in">
    <div class="hero-text">
    <!-- 行ごとに .ln で包むと、表示のときに下からせり上がる（global.css の data-anim='lines'） -->
    <h1
      id="hero-title"
      data-reveal
      aria-label={`${hero.headline.before}${fmt(hero.bar.price)}${hero.headline.after} ${hero.headline.second}`}>
      <span class="ln" aria-hidden="true">
        <span style="--n:0">
          {hero.headline.before}<span
            class="h-amt count"
            data-from={hero.bar.from}
            data-to={hero.bar.price}
            data-duration={hero.bar.duration}
            data-delay={hero.countDelay}
           >{fmt(hero.bar.price)}</span>{hero.headline.after}
        </span>
      </span>
      <span class="ln" aria-hidden="true">
        <span style="--n:1" class="h-best">{hero.headline.second}<sup>{hero.headline.mark}</sup></span>
      </span>
    </h1>
    <ul class="points" data-reveal style="--d:.08s">
      {
        hero.points.map((pt) => (
          <li>
            <Icon name="check" size={18} />
            <b>{pt.value}</b>
            <span>
              {pt.label}
              {pt.mark && <sup>{pt.mark}</sup>}
            </span>
          </li>
        ))
      }
    </ul>
    <!-- 文と文の改行はPCだけ。スマホでは自然に折り返す -->
    <p class="lead" data-reveal style="--d:.1s">
      {
        hero.lead.map((line, i) => (
          <>
            {i > 0 && lang === 'en' && ' '}
            {i > 0 && <br class="pc" />}
            {line}
          </>
        ))
      }
    </p>

    <div class="cta" data-reveal style="--d:.2s">
      <a class="btn btn-white btn-lg" href={hero.primary.href} target="_blank" rel="noopener">
        {hero.primary.label}<Icon name="arrow" />
      </a>
      <a class="btn btn-ghost-white btn-lg" href={hero.secondary.href}>{hero.secondary.label}</a>
      <span class="cta-note">{hero.bar.note}</span>
    </div>
    <p class="hero-notes" data-reveal style="--d:.25s">{hero.bar.bestNote}<br />{hero.bar.uptimeNote}</p>
    </div>
    <div class="hero-visual" data-reveal style="--d:.15s">
      <img src="/uploads/panel/server.webp" alt={hero.visualAlt} width="2000" height="1183" loading="eager" decoding="async" />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: clip;
    background: var(--b-deep);
    color: #fff;
    padding-block: clamp(48px, 7vw, 92px);
  }

  /* ---------- 背景：単色と、薄い「ASHIKA」の文字 ---------- */
  .bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }

  /* 大きく斜めにして、右上で見切れさせる（見出しの右の空いているところ） */
  .bg-word {
    position: absolute;
    right: -0.12em;
    top: -0.06em;
    font-size: clamp(8rem, 26vw, 24rem);
    font-weight: 900;
    letter-spacing: -0.04em;
    line-height: 1;
    color: rgba(255, 255, 255, 0.04);
    transform: rotate(-10deg);
    transform-origin: right top;
    white-space: nowrap;
    user-select: none;
  }

  .hero-in {
    position: relative;
    display: grid;
    gap: 40px;
    align-items: center;
  }

  /* ---------- ボタンと注記（紺の面に直接置く） ---------- */
  .cta {
    margin-top: clamp(24px, 3.4vw, 36px);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 14px;
  }

  .cta-note {
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.7);
  }

  .hero-notes {
    margin-top: 1.1rem;
    max-width: 70ch;
    font-size: 0.7rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.5);
  }

  /* ---------- 右のパネルの画面（PC だけ） ---------- */
  .hero-visual {
    display: none;
  }

  .hero-visual img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 10px;
    border: 1px solid rgba(255, 255, 255, 0.14);
  }

  @media (min-width: 1000px) {
    /* 右にパネルの画面があるので、背景の文字は出さない */
    .bg-word {
      display: none;
    }

    .hero-in {
      grid-template-columns: minmax(0, 1.08fr) minmax(0, 1fr);
      gap: 56px;
    }

    .hero-visual {
      display: block;
    }
  }

  @media (max-width: 560px) {
    .cta .btn {
      width: 100%;
    }
  }

  /* ---------- いちばん大きい見出し（月額30円から！国内最安値） ---------- */
  .hero h1 {
    color: #fff;
    font-size: clamp(2.1rem, 6.4vw, 4.1rem);
    font-weight: 900;
    line-height: 1.22;
    letter-spacing: -0.015em;
  }

  .h-amt {
    display: inline-block;
    /* 幅は取り置かない（減っている間だけ後ろの文字が少し動くが、止まったときに「月額」との間が空かない） */
    margin-inline: 0.06em;
    font-size: 1.35em;
    line-height: 1;
    color: #8fd0ff;
    font-variant-numeric: tabular-nums;
  }

  .h-best {
    display: inline-block;
  }

  .hero h1 sup,
  .points sup {
    font-size: 0.4em;
    vertical-align: super;
    margin-left: 0.1em;
  }

  .points sup {
    font-size: 0.7em;
  }

  /* ---------- 見出しの下の強み（チェックの印を付けて縦に並べる） ---------- */
  .points {
    margin-top: clamp(18px, 2.8vw, 26px);
    display: grid;
    gap: 0.45rem;
    list-style: none;
  }

  .points li {
    display: flex;
    align-items: baseline;
    gap: 0.4em;
    font-size: clamp(0.92rem, 1.5vw, 1.05rem);
    color: rgba(255, 255, 255, 0.8);
  }

  .points li :global(svg) {
    align-self: center;
    flex-shrink: 0;
    color: #8fd0ff;
  }

  .points b {
    font-size: 1.12em;
    font-weight: 900;
    color: #fff;
  }

  .hero .lead {
    margin-top: 1.2rem;
    max-width: 64ch;
    font-size: clamp(0.88rem, 1.4vw, 1rem);
    line-height: 1.95;
    color: rgba(255, 255, 255, 0.85);
  }

  .lead .pc {
    display: none;
  }

  /* ---------- 下の白い帯 ---------- */










  @media (min-width: 860px) {
    .lead .pc {
      display: inline;
    }
  }
</style>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // 見出しの金額が、大きい数字から一気に減って最小構成の月額に着地する
  const counters = document.querySelectorAll<HTMLElement>('.hero .count');
  if (counters.length && !reduce) {
    const fmt = (n: number) => n.toLocaleString('ja-JP');
    counters.forEach((el) => {
      const from = Number(el.dataset.from);
      const to = Number(el.dataset.to);
      const duration = Number(el.dataset.duration) || 1200;
      // 待ち時間と長さは src/data/home.ts の hero（countDelay と bar.duration）から data 属性で渡している
      const delay = Number(el.dataset.delay) || 0;
      el.textContent = fmt(from);
      el.classList.add('is-counting');
      const start = performance.now() + delay;
      const tick = (now: number) => {
        const t = Math.min(1, Math.max(0, (now - start) / duration));
        const eased = 1 - Math.pow(1 - t, 4); // 最初は速く、最後はゆっくり
        el.textContent = fmt(Math.round(from + (to - from) * eased));
        if (t < 1) {
          window.requestAnimationFrame(tick);
        } else {
          el.textContent = fmt(to);
          el.classList.remove('is-counting');
        }
      };
      window.requestAnimationFrame(tick);
    });
  }
</script>
