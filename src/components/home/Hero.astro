---
/**
 * 最初の画面。置くものは、強い見出し（月額30円から！）・短い一言・ボタン1つだけ。
 * 背景は、ロゴの「ボールを見上げるアシカ」を大きく描いた絵。
 * ボールから広がる輪と、手前の波を、色の段差だけで作る（ぼかし・グラデーションは使わない）。
 * 最安をうたうので、根拠（いつ・だれが調べたか）は同じ画面に1行で置く（景品表示法）。全文はページ下の「注記・出典」。
 */
import Icon from '../Icon.astro';
import { content } from '../../data/index';
import { langOf } from '../../i18n';

const lang = langOf(Astro.url);
const { hero } = content(lang).home;
---

<section class="hero" aria-labelledby="hero-title">
  <!-- 飾りの絵。読み上げには出さない -->
  <div class="art" aria-hidden="true">
    <div class="seal-box">
      <span class="disc d1"></span>
      <span class="disc d2"></span>
      <span class="disc d3"></span>
      <span class="disc d4"></span>
    </div>
    <svg class="wave" viewBox="0 0 1440 160" preserveAspectRatio="none">
      <path class="w-back" d="M0 60C180 20 360 100 540 60S900 20 1080 60s270 40 360-10v110H0Z"></path>
      <path class="w-mid" d="M0 92c200 40 380-40 600 0s380 38 600-6 180-14 240 8v66H0Z"></path>
    </svg>
    <div class="seal-box">
      <span class="seal"></span>
      <span class="ball"></span>
    </div>
    <svg class="wave" viewBox="0 0 1440 160" preserveAspectRatio="none">
      <path class="w-front" d="M0 126c240-30 420 24 720-4s460-26 720 8v30H0Z"></path>
    </svg>
  </div>

  <div class="container">
    <div class="copy">
      <p class="best">{hero.headline.second}<sup><a href="#notes">{hero.headline.mark}</a></sup></p>
      <h1 id="hero-title">
        {hero.headline.before}<span class="amt mk" data-count data-count-from={hero.bar.from} data-count-ms={hero.bar.duration} data-count-delay={hero.countDelay}>{hero.bar.price}</span>{hero.headline.after}
      </h1>
      <p class="sub">{hero.sub}</p>
      <a class="btn btn-primary btn-lg go" href={hero.primary.href} target="_blank" rel="noopener">
        {hero.primary.label}<Icon name="arrow" />
      </a>
      <p class="terms">{hero.bar.note}</p>
      <p class="note"><a href="#notes">{hero.bar.bestShort}</a></p>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: clip;
    background: var(--bg);
    /* 絵の大きさ。狭い画面では文の下に、広い画面では文の右に置く */
    --art-w: min(64vw, 300px);
    --art-r: 8%;
    --wave-h: clamp(84px, 11vw, 150px);
    padding-block: clamp(36px, 6vw, 84px) calc(var(--art-w) * 0.68 + var(--wave-h) * 0.5 + 24px);
  }

  /* ---------- 絵 ---------- */
  .art {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  /* 波の下端が半端なピクセルになっても、下の帯とのあいだに線が出ないようにふさぐ */
  .art::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 2px;
    background: var(--night);
  }

  .seal-box {
    position: absolute;
    right: var(--art-r);
    bottom: calc(var(--wave-h) * 0.24);
    width: var(--art-w);
    aspect-ratio: 900 / 596;
  }

  /* ロゴのアシカ。画像を型抜きに使って、青1色で塗る */
  .seal {
    position: absolute;
    inset: 0;
    background: var(--b);
    -webkit-mask: url('/brand/mark.png') center / contain no-repeat;
    mask: url('/brand/mark.png') center / contain no-repeat;
  }

  /* ボールと、そこから広がる輪。中心はロゴのボールの位置（左から94%、上から8.8%） */
  .ball,
  .disc {
    position: absolute;
    left: 94%;
    top: 8.8%;
    aspect-ratio: 1;
    border-radius: 50%;
    transform: translate(-50%, -50%);
  }

  .ball {
    width: 12.6%;
    background: var(--hl);
  }

  .d1 {
    width: 260%;
    background: #f3f6fb;
  }

  .d2 {
    width: 185%;
    background: #e7eef9;
  }

  .d3 {
    width: 118%;
    background: #d9e5f6;
  }

  .d4 {
    width: 60%;
    background: #c8daf3;
  }

  .wave {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: var(--wave-h);
  }

  .w-back {
    fill: #b9d0f1;
  }

  .w-mid {
    fill: #6fa3ec;
  }

  /* いちばん手前の波は、すぐ下の帯（濃紺）とつながる */
  .w-front {
    fill: var(--night);
  }

  /* ---------- 動き ----------
     文は上から順に出る。ボールはゆっくり弾み、輪は外へ広がるように息をし、奥の波は左右に揺れる。
     動きを減らす設定では、どれも止まったままにする。 */
  @media (prefers-reduced-motion: no-preference) {
    .copy > * {
      animation: hero-rise 0.7s var(--ease) both;
    }

    .copy > :nth-child(2) { animation-delay: 0.08s; }
    .copy > :nth-child(3) { animation-delay: 0.16s; }
    .copy > :nth-child(4) { animation-delay: 0.24s; }
    .copy > :nth-child(5) { animation-delay: 0.32s; }
    .copy > :nth-child(6) { animation-delay: 0.4s; }

    .seal-box {
      animation: hero-in 0.9s var(--ease) both;
    }

    .ball {
      animation: hero-bob 3.6s ease-in-out infinite;
    }

    .disc {
      animation: hero-breathe 6s ease-in-out infinite;
    }

    .d2 { animation-delay: 0.5s; }
    .d3 { animation-delay: 1s; }
    .d4 { animation-delay: 1.5s; }

    .w-back,
    .w-mid {
      transform-box: fill-box;
      transform-origin: center;
      scale: 1.08 1;
      animation: hero-sway 9s ease-in-out infinite alternate;
    }

    .w-mid {
      animation-duration: 7s;
      animation-direction: alternate-reverse;
    }
  }

  @keyframes hero-rise {
    from { opacity: 0; translate: 0 18px; }
  }

  @keyframes hero-in {
    from { opacity: 0; translate: 0 28px; }
  }

  @keyframes hero-bob {
    50% { translate: 0 -55%; }
  }

  @keyframes hero-breathe {
    50% { scale: 1.035; }
  }

  @keyframes hero-sway {
    from { translate: -2.5% 0; }
    to { translate: 2.5% 0; }
  }

  /* ---------- 文 ---------- */
  .best {
    display: inline-flex;
    align-items: baseline;
    padding: 0.3em 0.9em;
    border-radius: 999px;
    background: var(--night);
    color: #fff;
    font-size: clamp(1rem, 2vw, 1.25rem);
    font-weight: 700;
    letter-spacing: 0.1em;
    line-height: 1.4;
  }

  .best sup a,
  .note a {
    color: inherit;
  }

  .best sup a {
    text-decoration: none;
  }

  .best sup {
    font-size: 0.7em;
    font-weight: 400;
    letter-spacing: 0;
    margin-left: 0.2em;
  }

  h1 {
    margin-top: 0.9rem;
    font-size: clamp(2rem, 8.4vw, 5rem);
    line-height: 1.15;
    letter-spacing: 0;
    white-space: nowrap;
  }

  /* 英語は字数が多いので、ひとまわり小さくして1行に収める */
  :global(html[lang='en']) h1 {
    font-size: clamp(1.75rem, 6.6vw, 4rem);
  }

  .amt {
    font-size: 1.7em;
    font-weight: 800;
    line-height: 1;
    padding-inline: 0.06em;
    margin-inline: 0.04em;
  }

  .sub {
    margin-top: 1.25rem;
    color: var(--ink);
    font-size: clamp(1.0625rem, 1.9vw, 1.375rem);
    font-weight: 700;
    line-height: 1.6;
  }

  .go {
    margin-top: 1.75rem;
    min-width: min(100%, 15rem);
  }

  .terms {
    margin-top: 0.75rem;
    font-size: 0.875rem;
    color: var(--ink-2);
  }

  .note {
    margin-top: 1.5rem;
    max-width: 40em;
    font-size: 0.875rem;
    line-height: 1.65;
    color: var(--ink-2);
  }

  /* スマホ：見出しの強さは残したまま、まわりの文字と余白をひとまわり小さくする */
  @media (max-width: 599px) {
    .hero {
      padding-top: 26px;
    }

    .best {
      font-size: 0.875rem;
    }

    h1 {
      margin-top: 0.7rem;
      font-size: clamp(1.75rem, 7.6vw, 2.5rem);
    }

    .sub {
      margin-top: 0.9rem;
      font-size: 1rem;
    }

    .go {
      margin-top: 1.25rem;
      min-width: min(100%, 13.5rem);
    }

    .terms {
      margin-top: 0.6rem;
    }

    .note {
      margin-top: 1rem;
    }
  }

  /* タブレット：絵を右下に寄せ、注記は絵に重ならない幅にする */
  @media (min-width: 700px) {
    .hero {
      --art-w: min(42vw, 400px);
      --art-r: 6%;
      padding-bottom: calc(var(--wave-h) + 48px);
    }

    .note {
      max-width: 52%;
    }
  }

  @media (min-width: 1100px) {
    .hero {
      --art-w: min(38vw, 560px);
      --art-r: max(7%, calc(50% - 560px));
      padding-block: 72px calc(var(--wave-h) + 48px);
    }

    .copy {
      max-width: 50%;
    }

    .note {
      max-width: 40em;
    }

    h1 {
      font-size: min(4.6rem, 5.6vw);
    }

    :global(html[lang='en']) h1 {
      font-size: min(3.6rem, 4.4vw);
    }
  }
</style>
