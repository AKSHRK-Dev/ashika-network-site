---
/**
 * 全ページ共通のヘッダー。
 * 広い画面: いちばん上に細い帯（一言・関連サイト・言語）、その下に本体の帯（ロゴ・メニュー・ログイン・お申し込み）。
 *           画面の上に貼り付くのは本体の帯だけ（読む場所を広く残す）。
 * 狭い画面: 本体の帯はロゴ・お申し込み・「メニュー」ボタンだけにし、ボタンで帯のすぐ下にメニューを開く。
 *           メニューは帯の下に重ねて出すので、開いてもページは動かない。
 * 現在地のメニューには aria-current を付け、太い下線で示す（色だけに頼らない）。
 */
import Icon from './Icon.astro';
import { content } from '../data/index';
import { chrome, langOf, pathIn } from '../i18n';

const { pathname } = Astro.url;
const lang = langOf(Astro.url);
const { brand, nav, links, site, ui } = content(lang).site;
const words = chrome[lang];
const other = lang === 'en' ? 'ja' : 'en';
/* 同じページの別の言語。ページの中の位置（#…）は持ち越さない */
const switchHref = pathIn(pathname, other);
const homeHref = lang === 'en' ? '/en' : '/';
/* このサイトの中のメニューと、別サイトへのリンクを分けて置く */
const mainNav = nav.filter((n) => !n.external);
const subNav = nav.filter((n) => n.external);
const isCurrent = (href: string) =>
  href === homeHref ? pathname === homeHref : !href.startsWith('http') && !href.includes('#') && pathname.replace(/\.html$/, '').startsWith(href);
---

<!--
  いちばん上のお知らせの帯。中身はここには書かず、本番の server.mjs がページを返すときに、
  管理画面（dash.ashikanw.com の「ホームページのお知らせ」）で作ったものに置き換える。
  ビルドし直さなくても変わるように、目印のコメントだけを置いておく。
-->
<Fragment set:html="<!--ashika:site-notice-->" />

<!-- 広い画面だけの細い帯。別サイトへのリンクと言語の切り替え -->
<div class="topbar">
  <div class="container topbar-in">
    <p class="tagline">{ui.header.tagline}</p>
    <nav aria-label={ui.header.subAria}>
      <ul>
        {
          subNav.map((n) => (
            <li>
              <a href={n.href} target="_blank" rel="noopener">
                {n.label}
                <Icon name="external" size={13} />
              </a>
            </li>
          ))
        }
        <li class="topbar-lang">
          <a href={switchHref} hreflang={other} lang={other} aria-label={words.switchAria}>
            <Icon name="globe" size={16} />
            {words.switchTo}
          </a>
        </li>
      </ul>
    </nav>
  </div>
</div>

<header class="header" id="top">
  <div class="container bar">
    <a class="brand" href={homeHref} aria-label={ui.header.brandAria}>
      <img src={brand.header.src} alt={site.name} width={brand.header.width} height={brand.header.height} />
    </a>

    <nav class="gnav" aria-label={ui.header.navAria}>
      <ul>
        {
          mainNav.map((n) => (
            <li>
              <a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>
                {n.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="actions">
      <a class="btn btn-outline btn-sm login" href={links.dash} target="_blank" rel="noopener">{ui.header.login}</a>
      <a class="btn btn-primary btn-sm apply" href={links.shop} target="_blank" rel="noopener">{ui.header.register}</a>
      <button
        class="menu-btn"
        id="menuBtn"
        type="button"
        aria-expanded="false"
        aria-controls="menu"
        aria-label={ui.header.menuOpen}
        data-label-open={ui.header.menuOpen}
        data-label-close={ui.header.menuClose}
      >
        <span class="ic-open"><Icon name="menu" size={22} /></span>
        <span class="ic-close"><Icon name="close" size={22} /></span>
        <span class="menu-word" aria-hidden="true">{ui.header.menuAria}</span>
      </button>
    </div>
  </div>

  <!-- 狭い画面のメニュー。ボタンを押すと帯の下に重ねて開く -->
  <nav class="menu" id="menu" aria-label={ui.header.menuAria} hidden>
    <div class="container menu-in">
      <ul class="m-main">
        {
          mainNav.map((n) => (
            <li>
              <a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>
                <span>{n.label}</span>
                <Icon name="chevron" size={18} />
              </a>
            </li>
          ))
        }
      </ul>
      <ul class="m-sub">
        {
          subNav.map((n) => (
            <li>
              <a href={n.href} target="_blank" rel="noopener">
                {n.label}
                <Icon name="external" size={14} />
              </a>
            </li>
          ))
        }
        <li>
          <a href={switchHref} hreflang={other} lang={other}>
            <Icon name="globe" size={16} />
            {words.switchTo}
          </a>
        </li>
      </ul>
      <div class="m-actions">
        <a class="btn btn-outline" href={links.dash} target="_blank" rel="noopener">{ui.header.login}</a>
        <a class="btn btn-primary" href={links.shop} target="_blank" rel="noopener">
          {ui.header.register}
          <Icon name="arrow" size={18} class="arrow" />
        </a>
      </div>
    </div>
  </nav>
</header>
<!-- メニューを開いている間、下のページを少し暗くする。押すと閉じる -->
<div class="menu-shade" id="menuShade" hidden></div>

<script>
  const btn = document.getElementById('menuBtn');
  const menu = document.getElementById('menu');
  const shade = document.getElementById('menuShade');
  if (btn && menu) {
    const set = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', (open ? btn.dataset.labelClose : btn.dataset.labelOpen) ?? '');
      menu.hidden = !open;
      if (shade) shade.hidden = !open;
    };
    btn.addEventListener('click', () => set(btn.getAttribute('aria-expanded') !== 'true'));
    shade?.addEventListener('click', () => set(false));
    /* メニューの中のリンクを押したら閉じる（同じページの中の移動でも残らないように） */
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) set(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
        set(false);
        btn.focus();
      }
    });
    /* 広い画面に変わったら閉じておく */
    matchMedia('(min-width: 1080px)').addEventListener('change', (e) => e.matches && set(false));
  }
</script>

<style>
  /* ---------- いちばん上の細い帯（広い画面だけ） ---------- */
  .topbar {
    display: none;
  }

  /* ---------- 本体の帯 ---------- */
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 12px;
    height: var(--header-h);
  }

  .brand {
    display: flex;
    align-items: center;
    min-height: 44px;
    flex-shrink: 1;
    min-width: 0;
    margin-right: auto;
  }

  .brand img {
    width: auto;
    height: clamp(24px, 6.4vw, 30px);
  }

  .gnav,
  .login {
    display: none;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }

  .menu-btn {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1px;
    min-width: 52px;
    height: 48px;
    border: 1px solid var(--line-2);
    border-radius: 8px;
    color: var(--ink);
    font-size: 0.6875rem;
    font-weight: 700;
    line-height: 1.1;
  }

  .menu-btn:hover {
    background: var(--surface);
  }

  :global(html[lang='en']) .menu-word {
    font-size: 0.625rem;
  }

  .menu-btn .ic-close,
  .menu-btn[aria-expanded='true'] .ic-open {
    display: none;
  }

  .menu-btn[aria-expanded='true'] .ic-close {
    display: block;
  }

  .menu-btn[aria-expanded='true'] {
    background: var(--b-tint);
    border-color: var(--b);
    color: var(--b-deep);
  }

  /* ---------- 狭い画面のメニュー ---------- */
  .menu {
    position: absolute;
    inset: 100% 0 auto;
    max-height: calc(100dvh - var(--header-h));
    overflow-y: auto;
    overscroll-behavior: contain;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line-2);
    background: var(--bg);
  }

  .menu-in {
    padding-block: 4px 20px;
  }

  .menu ul {
    list-style: none;
  }

  .m-main li {
    border-bottom: 1px solid var(--line);
  }

  .m-main a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 56px;
    color: var(--ink);
    font-size: 1.0625rem;
    font-weight: 700;
  }

  .m-main a :global(svg) {
    flex-shrink: 0;
    color: var(--b);
    transform: rotate(-90deg);
  }

  .m-main a[aria-current='page'] {
    color: var(--b);
    box-shadow: inset 4px 0 0 var(--b);
    padding-left: 14px;
  }

  .m-sub {
    display: flex;
    flex-wrap: wrap;
    gap: 0 20px;
    padding-block: 8px;
  }

  .m-sub a {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    min-height: 44px;
    color: var(--ink-2);
    font-size: 0.9375rem;
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: var(--line-2);
    text-underline-offset: 0.3em;
  }

  .m-sub a :global(svg) {
    flex-shrink: 0;
    color: var(--ink-3);
  }

  .m-actions {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    gap: 10px;
    margin-top: 8px;
  }

  .menu-shade {
    position: fixed;
    inset: 0;
    z-index: 40;
    background: rgba(7, 32, 74, 0.45);
  }

  /* スマホでは帯を低くして、読む場所を広く残す。
     ボタンは見た目を 40px にするが、押せる範囲は上下に 2px ずつ広げて 44px のままにする */
  @media (max-width: 599px) {
    .bar {
      gap: 10px;
    }

    .brand img {
      height: clamp(21px, 5.8vw, 24px);
    }

    .apply,
    .menu-btn {
      position: relative;
    }

    .apply::after,
    .menu-btn::after {
      content: '';
      position: absolute;
      inset: -2px 0;
    }

    .apply {
      min-height: 40px;
    }

    .menu-btn {
      min-width: 46px;
      height: 40px;
    }

    .menu-btn :global(svg) {
      width: 20px;
      height: 20px;
    }

    .m-main a {
      min-height: 48px;
      font-size: 1rem;
    }
  }

  /* とても狭い画面では、帯の「お申し込み」を小さくしてロゴの場所を残す */
  @media (max-width: 359px) {
    .apply {
      padding-inline: 0.8rem;
      font-size: 0.875rem;
    }
  }

  /* ---------- 広い画面 ---------- */
  @media (min-width: 1080px) {
    .topbar {
      display: block;
      background: var(--surface);
      border-bottom: 1px solid var(--line);
      color: var(--ink-2);
      font-size: 0.875rem;
    }

    .topbar-in {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
      min-height: 40px;
    }

    .tagline {
      font-weight: 700;
      letter-spacing: 0.04em;
    }

    .topbar ul {
      display: flex;
      align-items: center;
      gap: 4px;
      list-style: none;
    }

    .topbar a {
      display: inline-flex;
      align-items: center;
      gap: 0.35em;
      min-height: 40px;
      padding-inline: 0.7rem;
      color: var(--ink-2);
    }

    .topbar a:hover {
      color: var(--b);
      text-decoration: underline;
      text-underline-offset: 0.25em;
    }

    .topbar a :global(svg) {
      color: var(--ink-3);
    }

    .topbar-lang {
      margin-left: 8px;
      padding-left: 8px;
      border-left: 1px solid var(--line-2);
    }

    .topbar-lang a {
      color: var(--ink);
      font-weight: 700;
    }

    .topbar-lang a :global(svg) {
      color: inherit;
    }

    .bar {
      gap: clamp(16px, 2.4vw, 40px);
    }

    .brand {
      margin-right: 0;
      flex-shrink: 0;
    }

    .brand img {
      height: 32px;
    }

    .gnav {
      display: block;
      align-self: stretch;
      margin-right: auto;
    }

    .gnav ul {
      display: flex;
      height: 100%;
      gap: clamp(0px, 0.6vw, 12px);
      list-style: none;
    }

    .gnav a {
      position: relative;
      display: flex;
      align-items: center;
      height: 100%;
      padding-inline: clamp(0.5rem, 0.9vw, 0.9rem);
      color: var(--ink);
      font-size: 0.9375rem;
      font-weight: 700;
      white-space: nowrap;
    }

    /* 現在地と、マウスを載せたところは、帯の下の端に太い線を出す（色だけに頼らない） */
    .gnav a::after {
      content: '';
      position: absolute;
      inset: auto clamp(0.5rem, 0.9vw, 0.9rem) -1px;
      height: 4px;
      border-radius: 2px 2px 0 0;
      background: transparent;
    }

    .gnav a:hover {
      color: var(--b);
    }

    .gnav a:hover::after {
      background: var(--b-line);
    }

    .gnav a[aria-current='page'] {
      color: var(--b);
    }

    .gnav a[aria-current='page']::after {
      background: var(--b);
    }

    .login {
      display: inline-flex;
    }

    .actions {
      gap: 10px;
    }

    .menu-btn,
    .menu,
    .menu-shade {
      display: none !important;
    }
  }
</style>
