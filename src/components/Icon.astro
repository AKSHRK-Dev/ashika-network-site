export type IconName = keyof typeof icons;

interface Props {
  name: IconName;
  size?: number;
  class?: string;
  /** 線の太さ。大きく見せるアイコンは 1.5 にして細くする */
  stroke?: number;
}

const { name, size = 18, class: className, stroke = 2 } = Astro.props;
const icon: IconDef = icons[name];
---

<svg
  class:list={[className, name === 'arrow' && 'arrow']}
  width={size}
  height={size}
  viewBox={icon.vb}
  aria-hidden="true"
  focusable="false"
  fill={icon.stroke ? 'none' : undefined}
  stroke={icon.stroke ? 'currentColor' : undefined}
  stroke-width={icon.stroke ? stroke : undefined}
  stroke-linecap={icon.stroke ? 'round' : undefined}
  stroke-linejoin={icon.stroke ? 'round' : undefined}
  set:html={icon.body}
/>
