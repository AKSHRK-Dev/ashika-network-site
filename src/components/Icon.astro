export type IconName = keyof typeof icons;

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 18, class: className } = Astro.props;
const icon: IconDef = icons[name];
---

<svg
  class:list={[className, name === 'arrow' && 'arrow']}
  width={size}
  height={size}
  viewBox={icon.vb}
  aria-hidden="true"
  focusable="false"
  fill={icon.stroke ? 'none' : undefined}
  stroke={icon.stroke ? 'currentColor' : undefined}
  stroke-width={icon.stroke ? 2 : undefined}
  stroke-linecap={icon.stroke ? 'round' : undefined}
  stroke-linejoin={icon.stroke ? 'round' : undefined}
  set:html={icon.body}
/>
