---
/**
 * 規約などの文書ページ用レイアウト。
 *
 * 本文は src/content/legal/*.html（純粋なHTML）を body プロパティで受け取る。
 * ここで見出しに id を振り、その一覧から目次を組み立てる。条文が多い文書でも
 * 目的の条を探せるようにするため、本文とは別に目次を持つ。
 */
import Base from './Base.astro';
import { site } from '../data/site';
import { breadcrumbLabels } from '../data/legal';

interface Props {
  title: string;
  /** 見出しに <br> などを入れたいとき用（未指定なら title） */
  heading?: string;
  en: string;
  date: string;
  description: string;
  path: string;
  /** 本文のHTML */
  body: string;
}

const { title, heading = title, en, date, description, path, body } = Astro.props;

/*
 * 本文の h2 / h3 に id を振りながら、目次の項目を集める。
 * id は日本語をURLに入れずに済むよう連番にする（s1, s2, …）。
 * level 2 は章または条、level 3 は章の中の条。
 */
type Heading = { id: string; level: number; label: string };
const headings: Heading[] = [];
const bodyWithIds = body.replace(/<h([23])>([\s\S]*?)<\/h\1>/g, (_match, level: string, inner: string) => {
  const id = `s${headings.length + 1}`;
  headings.push({ id, level: Number(level), label: inner.replace(/<[^>]+>/g, '').trim() });
  return `<h${level} id="${id}">${inner}</h${level}>`;
});

// 検索結果にパンくず（ホーム › 規約・方針 › 利用規約）を出すための構造化データ
const crumbs = [
  { name: breadcrumbLabels.home, item: `${site.url}/` },
  { name: breadcrumbLabels.legal, item: `${site.url}/legal` },
  ...(path !== '/legal' ? [{ name: title, item: `${site.url}${path}` }] : []),
];
const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: c.item })),
};
---

<Base title={title} description={description} path={path}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} slot="head" />

  <section class="doc-hero">
    <div class="container">
      <p class="doc-crumb">
        <a href="/legal">{breadcrumbLabels.legal}</a>
      </p>
      <h1 set:html={heading} />
      <p class="doc-en">{en}</p>
      <p class="doc-date">{date}</p>
    </div>
  </section>

  <div class="container doc-wrap">
    <nav class="doc-toc" aria-label="この文書の目次">
      <details open>
        <summary>目次</summary>
        <ol>
          {
            headings.map((h) => (
              <li class:list={[h.level === 3 && 'is-sub']}>
                <a href={`#${h.id}`}>{h.label}</a>
              </li>
            ))
          }
        </ol>
      </details>
    </nav>

    <article class="doc" set:html={bodyWithIds} />
  </div>
</Base>

<style is:global>
  /* ---------- 見出し帯 ---------- */
  .doc-hero {
    background: var(--surface);
    border-bottom: 1px solid var(--line);
    padding-block: clamp(28px, 4.5vw, 52px);
  }

  .doc-crumb {
    font-size: 0.78rem;
    color: var(--ink-3);
  }

  .doc-crumb a:hover {
    color: var(--b);
    text-decoration: underline;
  }

  .doc-hero h1 {
    margin-top: 0.5rem;
    padding-left: clamp(12px, 2vw, 18px);
    border-left: 3px solid var(--b);
    font-size: clamp(1.4rem, 3vw, 2.1rem);
    font-weight: 900;
    line-height: 1.4;
  }

  .doc-en {
    margin-top: 0.6rem;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--b-mid);
  }

  .doc-date {
    margin-top: 0.2rem;
    font-size: 0.8rem;
    color: var(--ink-3);
  }

  /* ---------- 目次 ＋ 本文の2段組み ---------- */
  .doc-wrap {
    padding-block: clamp(28px, 4.5vw, 56px) clamp(56px, 8vw, 96px);
  }

  .doc-toc {
    margin-bottom: 2rem;
  }

  .doc-toc details {
    border: 1px solid var(--line);
    border-radius: var(--r);
    background: var(--bg);
  }

  .doc-toc summary {
    padding: 0.7rem 0.9rem;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--ink);
    cursor: pointer;
    list-style: none;
  }

  .doc-toc summary::-webkit-details-marker {
    display: none;
  }

  .doc-toc summary::after {
    content: "＋";
    float: right;
    color: var(--ink-3);
    font-weight: 400;
  }

  .doc-toc details[open] summary::after {
    content: "−";
  }

  .doc-toc details[open] summary {
    border-bottom: 1px solid var(--line);
  }

  .doc-toc ol {
    list-style: none;
    padding: 0.5rem 0;
    max-height: min(60vh, 520px);
    overflow-y: auto;
  }

  .doc-toc li a {
    display: block;
    padding: 0.3rem 0.9rem;
    font-size: 0.8rem;
    line-height: 1.6;
    color: var(--ink-2);
    border-left: 2px solid transparent;
  }

  .doc-toc li.is-sub a {
    padding-left: 1.7rem;
    color: var(--ink-3);
  }

  .doc-toc li a:hover {
    border-left-color: var(--b);
    background: var(--b-tint);
    color: var(--b);
  }

  @media (min-width: 1000px) {
    .doc-wrap {
      display: grid;
      grid-template-columns: 232px minmax(0, 1fr);
      gap: clamp(32px, 5vw, 64px);
      align-items: start;
    }

    .doc-toc {
      position: sticky;
      top: calc(var(--header-h) + 20px);
      margin-bottom: 0;
    }

    /* 画面が広いときは開閉させる必要がないので、つまみを目印だけにする */
    .doc-toc summary {
      cursor: default;
      pointer-events: none;
    }

    .doc-toc summary::after {
      content: "";
    }
  }

  /* ---------- 本文 ---------- */
  .doc {
    max-width: var(--max-doc);
    font-size: 0.92rem;
  }

  .doc > .lead {
    padding: 0.9rem 1.1rem;
    border: 1px solid var(--b-line);
    border-left-width: 3px;
    border-radius: var(--r);
    background: var(--b-tint);
    color: var(--ink-2);
  }

  /* 章（利用規約のみ）。本文と同じ幅いっぱいの帯にする */
  .doc h2 {
    margin-top: clamp(2.2rem, 4vw, 3rem);
    padding: 0.5rem 0.9rem;
    background: var(--b-deep);
    color: #fff;
    border-radius: var(--r);
    font-size: 0.95rem;
    font-weight: 800;
    letter-spacing: 0.04em;
  }

  /* 条 */
  .doc h3 {
    margin-top: clamp(1.6rem, 3vw, 2.2rem);
    padding-left: 0.7rem;
    border-left: 3px solid var(--b);
    font-size: 1.05rem;
    font-weight: 800;
  }

  /* 章のすぐ下に条が来るときは、離しすぎない */
  .doc h2 + h3 {
    margin-top: 1.2rem;
  }

  .doc h2 + *,
  .doc h3 + * {
    margin-top: 0.8rem;
  }

  .doc p {
    margin-top: 0.9rem;
  }

  /* 番号付きの項。番号は濃紺、ぶら下げて揃える */
  .doc ol.clause {
    margin-top: 0.9rem;
    padding-left: 0;
    list-style: none;
    counter-reset: clause;
    display: grid;
    gap: 0.5rem;
  }

  .doc ol.clause > li {
    counter-increment: clause;
    padding-left: 2.2em;
    position: relative;
  }

  .doc ol.clause > li::before {
    content: counter(clause) ".";
    position: absolute;
    left: 0;
    top: 0;
    width: 1.8em;
    text-align: right;
    font-weight: 700;
    color: var(--b);
    font-variant-numeric: tabular-nums;
  }

  /* 箇条書き。記号は小さな四角（丸より実直に見える） */
  .doc ul.items {
    margin-top: 0.7rem;
    padding-left: 0;
    list-style: none;
    display: grid;
    gap: 0.35rem;
  }

  .doc ul.items > li {
    padding-left: 1.2em;
    position: relative;
  }

  .doc ul.items > li::before {
    content: "";
    position: absolute;
    left: 0.15em;
    top: 0.78em;
    width: 5px;
    height: 5px;
    background: var(--b-line);
  }

  /* 項の中に入れ子になった箇条書きは、少し詰めて区別する */
  .doc ol.clause ul.items,
  .doc dd ul.items {
    margin-top: 0.5rem;
  }

  /* ---------- 表形式の表示（特商法・資金決済法） ---------- */
  .doc dl.facts {
    margin-top: 1.4rem;
    border-top: 1px solid var(--line-2);
  }

  .doc dl.facts > div {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
    gap: 0.3rem 1.5rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--line);
  }

  .doc dl.facts dt {
    font-weight: 700;
    color: var(--ink);
  }

  @media (max-width: 640px) {
    .doc dl.facts > div {
      grid-template-columns: 1fr;
      gap: 0.15rem;
      padding: 0.75rem 0;
    }

    .doc dl.facts dt {
      font-size: 0.85rem;
      color: var(--b);
    }
  }

  /* ---------- 細部 ---------- */
  .doc a {
    color: var(--b-mid);
    text-decoration: underline;
    text-underline-offset: 3px;
    word-break: break-all;
  }

  .doc a:hover {
    color: var(--b-deep);
  }

  .doc small {
    display: inline-block;
    margin-top: 0.3rem;
    font-size: 0.82em;
    line-height: 1.7;
    color: var(--ink-3);
  }

  .doc .end {
    margin-top: clamp(2.2rem, 4vw, 3rem);
    padding-top: 1rem;
    border-top: 1px solid var(--line);
    text-align: right;
    font-weight: 700;
    color: var(--ink);
  }
</style>
